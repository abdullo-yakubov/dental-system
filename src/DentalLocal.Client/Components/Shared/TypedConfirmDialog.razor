<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@LucideIcons.AlertTriangle" Color="Color.Error" />
            <MudText Typo="Typo.h6">@Title</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-4">@Message</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Чтобы подтвердить, введите слово <b>@ConfirmationWord</b> в поле ниже:
        </MudText>
        <MudTextField @bind-Value="_input" Immediate="true" Label="Подтверждение" AutoFocus="true"
                      Placeholder="@ConfirmationWord" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(!IsConfirmed)" OnClick="Confirm">
            @ConfirmButtonText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Title { get; set; } = "Подтверждение";
    [Parameter] public string Message { get; set; } = "Это действие нельзя отменить.";
    [Parameter] public string ConfirmationWord { get; set; } = "УДАЛИТЬ";
    [Parameter] public string ConfirmButtonText { get; set; } = "Подтвердить";

    private string _input = string.Empty;

    private bool IsConfirmed => string.Equals(_input.Trim(), ConfirmationWord, StringComparison.Ordinal);

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}
