<div class="d-flex justify-center mb-4" style="gap:10px;">
    @for (var i = 0; i < Length; i++)
    {
        var filled = i < Code.Length;
        <div style="width:14px;height:14px;border-radius:50%;background:@(filled ? "var(--mud-palette-primary)" : "var(--app-glass-border)");transition:background var(--app-transition);"></div>
    }
</div>

<MudGrid Spacing="2">
    @foreach (var digit in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
    {
        <MudItem xs="4">
            <MudButton FullWidth="true" Variant="Variant.Outlined" Class="login-keypad-btn" OnClick="() => AppendDigit(digit)" Disabled="Disabled">@digit</MudButton>
        </MudItem>
    }
    <MudItem xs="4">
        <MudButton FullWidth="true" Variant="Variant.Text" Class="login-keypad-btn" OnClick="RemoveLastDigit" Disabled="Disabled">
            <MudIcon Icon="@Icons.Material.Filled.Backspace" />
        </MudButton>
    </MudItem>
    <MudItem xs="4">
        <MudButton FullWidth="true" Variant="Variant.Outlined" Class="login-keypad-btn" OnClick="AppendZero" Disabled="Disabled">0</MudButton>
    </MudItem>
    <MudItem xs="4">
        <MudButton FullWidth="true" Variant="Variant.Text" Class="login-keypad-btn" OnClick="ClearCode" Disabled="Disabled">
            <MudIcon Icon="@Icons.Material.Filled.Clear" />
        </MudButton>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> CodeChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int Length { get; set; } = 6;

    private Task SetCode(string value) => CodeChanged.InvokeAsync(value);
    private Task AppendDigit(string digit) => SetCode(Code + digit);
    private Task AppendZero() => AppendDigit("0");
    private Task RemoveLastDigit() => Code.Length > 0 ? SetCode(Code[..^1]) : Task.CompletedTask;
    private Task ClearCode() => SetCode(string.Empty);

    public Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (Disabled)
            return Task.CompletedTask;

        if (e.Key.Length == 1 && char.IsDigit(e.Key[0]))
            return AppendDigit(e.Key);

        if (e.Key == "Backspace")
            return RemoveLastDigit();

        if (e.Key == "Escape")
            return ClearCode();

        return Task.CompletedTask;
    }
}
