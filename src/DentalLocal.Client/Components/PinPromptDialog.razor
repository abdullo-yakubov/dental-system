<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@LucideIcons.Lock" Class="mr-2" Style="vertical-align: middle;" />
            @MudDialog.Title
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_pin" Label="Код доступа" InputType="InputType.Password"
                      Variant="Variant.Outlined" Immediate="true" AutoFocus="true"
                      OnKeyDown="OnKeyDown" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="string.IsNullOrWhiteSpace(_pin)">
            Подтвердить
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _pin = string.Empty;

    private void Submit() => MudDialog.Close(DialogResult.Ok(_pin));
    private void Cancel() => MudDialog.Cancel();

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_pin))
            Submit();
    }
}
