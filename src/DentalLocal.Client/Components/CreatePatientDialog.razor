@inject ApiClient Api
@inject ISnackbar Snackbar
@inject DraftAutosaveService Drafts
@inject IDialogService DialogService
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>@(Patient == null ? "Новый пациент" : "Редактировать пациента")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="this">
            <MudTextField @bind-Value="_lastName" Label="Фамилия" Required="true" Class="mb-2" />
            <MudTextField @bind-Value="_firstName" Label="Имя" Required="true" Class="mb-2" />
            <MudTextField @bind-Value="_middleName" Label="Отчество" Class="mb-2" />
            <MudSelect T="Gender" @bind-Value="_gender" Label="Пол" Class="mb-2">
                <MudSelectItem Value="Gender.Male">Мужской</MudSelectItem>
                <MudSelectItem Value="Gender.Female">Женский</MudSelectItem>
            </MudSelect>
            <MudDatePicker @bind-Date="_birthDate" Label="Дата рождения" Class="mb-2" />
            <MudTextField @bind-Value="_phone" Label="Телефон" Required="true" Class="mb-2" />
            <MudTextField @bind-Value="_address" Label="Адрес" Class="mb-2" />
            <MudTextField @bind-Value="_allergies" Label="Аллергии" Lines="2" Class="mb-2" />
            <MudTextField @bind-Value="_chronicDiseases" Label="Хронические заболевания" Lines="2" />
        </MudForm>
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_isBusy">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public PatientDto? Patient { get; set; }

    private MudForm? _form;
    private string _lastName = string.Empty;
    private string _firstName = string.Empty;
    private string? _middleName;
    private Gender _gender = Gender.Male;
    private DateTime? _birthDate;
    private string _phone = string.Empty;
    private string? _address;
    private string? _allergies;
    private string? _chronicDiseases;
    private string? _errorMessage;
    private bool _isBusy;
    private DraftAutosaveTimer? _autosaveTimer;
    private const string DraftKey = "new-patient";

    private record Draft(string LastName, string FirstName, string? MiddleName, Gender Gender,
        DateTime? BirthDate, string Phone, string? Address, string? Allergies, string? ChronicDiseases);

    protected override async Task OnParametersSetAsync()
    {
        if (Patient != null)
        {
            _lastName = Patient.LastName;
            _firstName = Patient.FirstName;
            _middleName = Patient.MiddleName;
            _gender = Patient.Gender;
            _birthDate = Patient.BirthDate.ToDateTime(TimeOnly.MinValue);
            _phone = Patient.Phone;
            _address = Patient.Address;
            _allergies = Patient.Allergies;
            _chronicDiseases = Patient.ChronicDiseases;
            return;
        }

        // Черновик восстанавливается только для формы нового пациента (раздел 10 ТЗ: autosave форм).
        var draft = await Drafts.LoadAsync<Draft>(DraftKey);
        if (draft is not null)
        {
            _lastName = draft.LastName;
            _firstName = draft.FirstName;
            _middleName = draft.MiddleName;
            _gender = draft.Gender;
            _birthDate = draft.BirthDate;
            _phone = draft.Phone;
            _address = draft.Address;
            _allergies = draft.Allergies;
            _chronicDiseases = draft.ChronicDiseases;
            Snackbar.Add("Восстановлен несохранённый черновик пациента.", Severity.Info);
        }

        _autosaveTimer = new DraftAutosaveTimer(SaveDraftAsync);
    }

    private Task SaveDraftAsync()
    {
        if (Patient != null)
            return Task.CompletedTask;

        var draft = new Draft(_lastName, _firstName, _middleName, _gender, _birthDate, _phone, _address, _allergies, _chronicDiseases);
        return Drafts.SaveAsync(DraftKey, draft);
    }

    private void Cancel() => MudDialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        if (_autosaveTimer is not null)
            await _autosaveTimer.DisposeAsync();
    }

    private async Task<bool> ConfirmNoDuplicateAsync()
    {
        if (_birthDate is null || string.IsNullOrWhiteSpace(_lastName) || string.IsNullOrWhiteSpace(_firstName))
            return true;

        try
        {
            var duplicates = await Api.CheckPatientDuplicateAsync(_lastName, _firstName, DateOnly.FromDateTime(_birthDate.Value));
            if (duplicates.Count == 0)
                return true;

            var names = string.Join(", ", duplicates.Select(d => $"{d.FullName} ({d.BirthDate:dd.MM.yyyy})"));
            var result = await DialogService.ShowMessageBoxAsync(
                "Возможно, такой пациент уже есть",
                $"Найдены похожие карты пациентов: {names}. Всё равно создать новую карту?",
                yesText: "Создать всё равно", cancelText: "Отмена");

            return result == true;
        }
        catch (ApiException)
        {
            // Если проверка недоступна — не блокируем создание пациента.
            return true;
        }
    }

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid || _birthDate is null)
        {
            _errorMessage = "Заполните обязательные поля.";
            return;
        }

        // Защита от задвоения карт (п.17.13 ТЗ) — только при создании нового пациента.
        if (Patient is null)
        {
            var confirmed = await ConfirmNoDuplicateAsync();
            if (!confirmed)
                return;
        }

        _isBusy = true;
        _errorMessage = null;

        try
        {
            if (Patient != null)
            {
                var updateRequest = new UpdatePatientRequest(
                    _lastName, _firstName, _middleName, _gender, DateOnly.FromDateTime(_birthDate.Value),
                    _phone, Patient.PhoneExtra, _address, _allergies, _chronicDiseases, Patient.Comments, Patient.DoctorNotes);

                var updated = await Api.UpdatePatientAsync(Patient.Id, updateRequest);
                Snackbar.Add($"Пациент «{updated.FullName}» изменен.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(updated));
            }
            else
            {
                var request = new CreatePatientRequest(
                    _lastName, _firstName, _middleName, _gender, DateOnly.FromDateTime(_birthDate.Value),
                    _phone, null, _address, _allergies, _chronicDiseases, null, null);

                var created = await Api.CreatePatientAsync(request);
                await Drafts.ClearAsync(DraftKey);
                Snackbar.Add($"Пациент «{created.FullName}» добавлен.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(created));
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
