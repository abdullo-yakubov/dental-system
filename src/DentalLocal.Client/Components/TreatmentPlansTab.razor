@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6" Class="font-weight-bold">Планы лечения</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@LucideIcons.Plus" OnClick="OpenCreatePlanAsync">
            Новый план
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_plans.Count == 0)
    {
        <MudText Class="text-secondary text-center py-6">Планы лечения ещё не созданы.</MudText>
    }
    else
    {
        @foreach (var plan in _plans)
        {
            <MudCard Outlined="true" Class="border-radius-8 mb-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@plan.Title</MudText>
                                <MudText Typo="Typo.caption" Class="text-secondary">
                                    Создан @plan.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy") · Выполнено @plan.CompletedCount из @plan.Items.Count
                                </MudText>
                            </MudStack>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(plan.Status)">@GetStatusLabel(plan.Status)</MudChip>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@plan.TotalEstimatedPrice.ToString("N0") сомони</MudText>
                            </MudStack>
                        </MudStack>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (!string.IsNullOrWhiteSpace(plan.Notes))
                    {
                        <MudText Typo="Typo.body2" Class="text-secondary mb-3">@plan.Notes</MudText>
                    }

                    @if (plan.Items.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="text-secondary">Позиции ещё не добавлены.</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Elevation="0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Процедура</th>
                                    <th>Зуб</th>
                                    <th>Цена</th>
                                    <th>Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in plan.Items.OrderBy(i => i.OrderIndex))
                                {
                                    <tr>
                                        <td>@(item.OrderIndex + 1)</td>
                                        <td>@item.ProcedureName</td>
                                        <td>@(item.ToothNumber?.ToString() ?? "—")</td>
                                        <td>@item.EstimatedPrice.ToString("N0") сомони</td>
                                        <td>
                                            @if (item.IsCompleted)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@LucideIcons.Check">Выполнено</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Ожидает</MudChip>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudCardContent>
                @if (plan.Status is TreatmentPlanStatus.Draft or TreatmentPlanStatus.Active)
                {
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@LucideIcons.ListPlus" OnClick="@(() => OpenAddItemAsync(plan))">
                            Добавить позицию
                        </MudButton>
                        @if (plan.Status == TreatmentPlanStatus.Draft)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Success" Size="Size.Small" StartIcon="@LucideIcons.Play" OnClick="@(() => ActivatePlanAsync(plan))">
                                Активировать
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@LucideIcons.XCircle" OnClick="@(() => CancelPlanAsync(plan))">
                            Отменить
                        </MudButton>
                    </MudCardActions>
                }
            </MudCard>
        }
    }
</MudStack>

@code {
    [Parameter] public Guid PatientId { get; set; }

    private List<TreatmentPlanDto> _plans = [];
    private List<ProcedureDto> _procedures = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var plansTask = Api.GetPatientTreatmentPlansAsync(PatientId);
            var proceduresTask = Api.GetProceduresAsync();

            await Task.WhenAll(plansTask, proceduresTask);

            _plans = (await plansTask).ToList();
            _procedures = (await proceduresTask).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Не удалось загрузить планы лечения: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreatePlanAsync()
    {
        var parameters = new DialogParameters<CreateTreatmentPlanDialog>
        {
            { x => x.PatientId, PatientId }
        };

        var dialog = await DialogService.ShowAsync<CreateTreatmentPlanDialog>("Новый план лечения", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadDataAsync();
    }

    private async Task OpenAddItemAsync(TreatmentPlanDto plan)
    {
        var parameters = new DialogParameters<AddTreatmentPlanItemDialog>
        {
            { x => x.TreatmentPlanId, plan.Id },
            { x => x.Procedures, _procedures },
            { x => x.NextOrderIndex, plan.Items.Count }
        };

        var dialog = await DialogService.ShowAsync<AddTreatmentPlanItemDialog>("Добавить позицию плана", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadDataAsync();
    }

    private async Task ActivatePlanAsync(TreatmentPlanDto plan)
    {
        try
        {
            await Api.ActivateTreatmentPlanAsync(plan.Id);
            Snackbar.Add("План лечения активирован.", Severity.Success);
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelPlanAsync(TreatmentPlanDto plan)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Отмена плана лечения",
            "Вы действительно хотите отменить этот план лечения?",
            yesText: "Отменить план", cancelText: "Назад");

        if (confirm != true)
            return;

        try
        {
            await Api.CancelTreatmentPlanAsync(plan.Id);
            Snackbar.Add("План лечения отменён.", Severity.Warning);
            await LoadDataAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private static Color GetStatusColor(TreatmentPlanStatus status) => status switch
    {
        TreatmentPlanStatus.Draft => Color.Default,
        TreatmentPlanStatus.Active => Color.Info,
        TreatmentPlanStatus.Completed => Color.Success,
        TreatmentPlanStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private static string GetStatusLabel(TreatmentPlanStatus status) => status switch
    {
        TreatmentPlanStatus.Draft => "Черновик",
        TreatmentPlanStatus.Active => "Активен",
        TreatmentPlanStatus.Completed => "Завершён",
        TreatmentPlanStatus.Cancelled => "Отменён",
        _ => status.ToString()
    };
}
