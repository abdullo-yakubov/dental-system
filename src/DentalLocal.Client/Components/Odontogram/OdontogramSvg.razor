@inject ApiClient Api
@inject ISnackbar Snackbar

<div class="odontogram-container">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">Одонтограмма</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @if (_multiSelectMode && _multiSelectedTeeth.Count > 0)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenMultiSelectPanel">
                        Применить ко всем выбранным (@_multiSelectedTeeth.Count)
                    </MudButton>
                }
                <MudButton Size="Size.Small" Variant="@(_multiSelectMode ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ChecklistRtl"
                           OnClick="ToggleMultiSelectMode">
                    Режим мультивыбора
                </MudButton>
                <MudChipSet T="bool" @bind-SelectedValues="_modeSelection">
                    <MudChip T="bool" Value="false" Variant="Variant.Outlined" Size="Size.Small">Взрослые</MudChip>
                    <MudChip T="bool" Value="true" Variant="Variant.Outlined" Size="Size.Small">Молочные</MudChip>
                </MudChipSet>
            </MudStack>
        </MudStack>

        <div class="odontogram-wrapper">
            <!-- Upper jaw -->
            <div class="jaw-label">Верхняя челюсть</div>
            <div class="jaw-row">
                @foreach (var n in (_isDeciduous ? UpperDeciduous : UpperAdult))
                {
                    <div class="tooth-cell @GetToothClass(n) @(_multiSelectedTeeth.Contains(n) ? "tooth-multi-selected" : "")"
                         @onclick="() => OnToothClick(n)" title="@GetToothLabel(n)">
                        <SvgTooth ToothNumber="@n" State="GetToothState(n)" SurfaceStates="GetSurfaceStates(n)" OnSurfaceClick="OnSurfaceClick" />
                        <span class="tooth-number">@n</span>
                    </div>
                }
            </div>

            <!-- Lower jaw -->
            <div class="jaw-row lower">
                @foreach (var n in (_isDeciduous ? LowerDeciduous : LowerAdult))
                {
                    <div class="tooth-cell @GetToothClass(n) @(_multiSelectedTeeth.Contains(n) ? "tooth-multi-selected" : "")"
                         @onclick="() => OnToothClick(n)" title="@GetToothLabel(n)">
                        <SvgTooth ToothNumber="@n" State="GetToothState(n)" SurfaceStates="GetSurfaceStates(n)" OnSurfaceClick="OnSurfaceClick" />
                        <span class="tooth-number">@n</span>
                    </div>
                }
            </div>
            <div class="jaw-label">Нижняя челюсть</div>
        </div>

        <!-- Legend -->
        <OdontogramLegend />

        <!-- Surface edit panel (клик по поверхности) -->
        @if (_selectedSurface.HasValue)
        {
            <ToothDetailPanel
                PatientId="PatientId"
                ToothNumber="_selectedSurface.Value.ToothNumber"
                SurfaceCode="_selectedSurface.Value.SurfaceCode"
                CurrentState="GetToothState(_selectedSurface.Value.ToothNumber)"
                VisitId="VisitId"
                OnStateSaved="OnStateSaved"
                OnClose="() => _selectedSurface = null" />
        }

        <!-- Tooth timeline panel (клик по зубу целиком) -->
        @if (_selectedToothNumber.HasValue)
        {
            <ToothTimelinePanel
                PatientId="PatientId"
                ToothNumber="_selectedToothNumber.Value"
                OnClose="() => _selectedToothNumber = null" />
        }

        <!-- Мультивыбор: общий диагноз на несколько зубов сразу (п.17.13 ТЗ) -->
        @if (_showMultiSelectPanel && _multiSelectedTeeth.Count > 0)
        {
            <ToothDetailPanel
                PatientId="PatientId"
                ToothNumber="_multiSelectedTeeth.First()"
                SurfaceCode="O"
                CurrentState="GetToothState(_multiSelectedTeeth.First())"
                MultiToothNumbers="_multiSelectedTeeth.ToList()"
                VisitId="VisitId"
                OnStateSaved="OnMultiStateSaved"
                OnClose="() => _showMultiSelectPanel = false" />
        }
    }
</div>

@code {
    [Parameter] public Guid PatientId { get; set; }
    [Parameter] public Guid? VisitId { get; set; }

    private OdontogramDto? _odontogram;
    private bool _loading = true;
    private int? _selectedToothNumber;
    private (int ToothNumber, string SurfaceCode)? _selectedSurface;
    private bool _isDeciduous;
    private IReadOnlyCollection<bool> _modeSelection = [];
    private bool _multiSelectMode;
    private readonly HashSet<int> _multiSelectedTeeth = [];
    private bool _showMultiSelectPanel;

    // FDI adult tooth numbers
    private static readonly int[] UpperAdult = [18, 17, 16, 15, 14, 13, 12, 11, 21, 22, 23, 24, 25, 26, 27, 28];
    private static readonly int[] LowerAdult = [48, 47, 46, 45, 44, 43, 42, 41, 31, 32, 33, 34, 35, 36, 37, 38];
    // FDI deciduous tooth numbers
    private static readonly int[] UpperDeciduous = [55, 54, 53, 52, 51, 61, 62, 63, 64, 65];
    private static readonly int[] LowerDeciduous = [85, 84, 83, 82, 81, 71, 72, 73, 74, 75];

    protected override async Task OnParametersSetAsync()
    {
        if (PatientId == Guid.Empty) return;

        _loading = true;
        try
        {
            _odontogram = await Api.GetOdontogramAsync(PatientId);
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Ошибка загрузки одонтограммы: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private ToothStateType GetToothState(int toothNumber)
    {
        var tooth = _odontogram?.Teeth.FirstOrDefault(t => t.ToothNumber == toothNumber);
        return tooth?.State ?? ToothStateType.Healthy;
    }

    private Dictionary<string, ToothStateType> GetSurfaceStates(int toothNumber) =>
        _odontogram?.SurfaceStates
            .Where(s => s.ToothNumber == toothNumber)
            .ToDictionary(s => s.SurfaceCode, s => s.Status)
        ?? [];

    private string GetToothClass(int toothNumber)
    {
        var state = GetToothState(toothNumber);
        return $"tooth-state-{state.ToString().ToLower()}";
    }

    private string GetToothLabel(int toothNumber) =>
        $"Зуб {toothNumber} — {GetStateName(GetToothState(toothNumber))}";

    private static string GetStateName(ToothStateType state) => state switch
    {
        ToothStateType.Healthy => "Здоров",
        ToothStateType.Caries => "Кариес",
        ToothStateType.Filling => "Пломба",
        ToothStateType.Extracted => "Удалён",
        ToothStateType.Crown => "Коронка",
        ToothStateType.Implant => "Имплант",
        ToothStateType.Veneer => "Винир",
        ToothStateType.RootCanalTreated => "Лечение каналов",
        ToothStateType.Cracked => "Трещина",
        ToothStateType.Destroyed => "Разрушен",
        ToothStateType.Pulpitis => "Пульпит",
        ToothStateType.Periodontitis => "Периодонтит",
        ToothStateType.Bridge => "Мост",
        ToothStateType.Missing => "Отсутствует",
        _ => state.ToString()
    };

    private void OnToothClick(int toothNumber)
    {
        if (_multiSelectMode)
        {
            if (!_multiSelectedTeeth.Remove(toothNumber))
                _multiSelectedTeeth.Add(toothNumber);
            return;
        }

        _selectedSurface = null;
        _selectedToothNumber = _selectedToothNumber == toothNumber ? null : toothNumber;
    }

    private void ToggleMultiSelectMode()
    {
        _multiSelectMode = !_multiSelectMode;
        _multiSelectedTeeth.Clear();
        _showMultiSelectPanel = false;
        if (_multiSelectMode)
        {
            _selectedToothNumber = null;
            _selectedSurface = null;
        }
    }

    private void OpenMultiSelectPanel() => _showMultiSelectPanel = true;

    private async Task OnMultiStateSaved()
    {
        _odontogram = await Api.GetOdontogramAsync(PatientId);
        _showMultiSelectPanel = false;
        _multiSelectedTeeth.Clear();
        _multiSelectMode = false;
        StateHasChanged();
    }

    private void OnSurfaceClick(int toothNumber, string surfaceCode)
    {
        if (_multiSelectMode)
        {
            OnToothClick(toothNumber);
            return;
        }

        _selectedToothNumber = null;
        _selectedSurface = (toothNumber, surfaceCode);
    }

    private async Task OnStateSaved()
    {
        _odontogram = await Api.GetOdontogramAsync(PatientId);
        _selectedSurface = null;
        StateHasChanged();
    }
}
