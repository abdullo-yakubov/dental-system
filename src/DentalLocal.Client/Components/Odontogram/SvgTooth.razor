@*  SVG representation of a single tooth with 5 clickable surfaces  *@

<svg class="tooth-svg" viewBox="0 0 50 60" xmlns="http://www.w3.org/2000/svg"
     @onclick:stopPropagation="true">
    @if (IsExtracted)
    {
        <!-- Extracted/Missing — show X -->
        <rect x="5" y="5" width="40" height="50" rx="4" fill="#e5e7eb" stroke="#9ca3af" stroke-width="1.5" />
        <line x1="12" y1="12" x2="38" y2="48" stroke="#9ca3af" stroke-width="2.5" stroke-linecap="round" />
        <line x1="38" y1="12" x2="12" y2="48" stroke="#9ca3af" stroke-width="2.5" stroke-linecap="round" />
    }
    else
    {
        <!-- Buccal/Vestibular (top) -->
        <polygon points="5,5 45,5 38,18 12,18"
                 fill="@GetSurfaceColor("B")"
                 stroke="white" stroke-width="1"
                 @onclick='() => OnSurfaceClick?.Invoke(ToothNumber, "B")'
                 class="tooth-surface" />

        <!-- Lingual/Palatal (bottom) -->
        <polygon points="12,42 38,42 45,55 5,55"
                 fill="@GetSurfaceColor("L")"
                 stroke="white" stroke-width="1"
                 @onclick='() => OnSurfaceClick?.Invoke(ToothNumber, "L")'
                 class="tooth-surface" />

        <!-- Mesial (left) -->
        <polygon points="5,5 12,18 12,42 5,55"
                 fill="@GetSurfaceColor("M")"
                 stroke="white" stroke-width="1"
                 @onclick='() => OnSurfaceClick?.Invoke(ToothNumber, "M")'
                 class="tooth-surface" />

        <!-- Distal (right) -->
        <polygon points="45,5 38,18 38,42 45,55"
                 fill="@GetSurfaceColor("D")"
                 stroke="white" stroke-width="1"
                 @onclick='() => OnSurfaceClick?.Invoke(ToothNumber, "D")'
                 class="tooth-surface" />

        <!-- Occlusal/Incisal (center) -->
        <rect x="12" y="18" width="26" height="24" rx="2"
              fill="@GetSurfaceColor("O")"
              stroke="white" stroke-width="1"
              @onclick='() => OnSurfaceClick?.Invoke(ToothNumber, "O")'
              class="tooth-surface" />

        @if (State == ToothStateType.Cracked)
        {
            <!-- Crack indicator -->
            <line x1="25" y1="5" x2="28" y2="55" stroke="#f97316" stroke-width="2" stroke-dasharray="4,2" />
        }
    }
</svg>

@code {
    [Parameter] public int ToothNumber { get; set; }
    [Parameter] public ToothStateType State { get; set; }
    [Parameter] public Dictionary<string, ToothStateType>? SurfaceStates { get; set; }
    [Parameter] public Action<int, string>? OnSurfaceClick { get; set; }

    private bool IsExtracted => State == ToothStateType.Extracted || State == ToothStateType.Missing;

    private string GetSurfaceColor(string surface)
    {
        var state = SurfaceStates != null && SurfaceStates.TryGetValue(surface, out var s) ? s : State;
        return GetStateColor(state);
    }

    private static string GetStateColor(ToothStateType state) => state switch
    {
        ToothStateType.Healthy => "#f9fafb",
        ToothStateType.Caries => "#92400e",
        ToothStateType.Filling => "#1d4ed8",
        ToothStateType.Crown => "#b45309",
        ToothStateType.Implant => "#6b7280",
        ToothStateType.Veneer => "#0891b2",
        ToothStateType.RootCanalTreated => "#dc2626",
        ToothStateType.Cracked => "#ea580c",
        ToothStateType.Destroyed => "#7f1d1d",
        ToothStateType.Pulpitis => "#b91c1c",
        ToothStateType.Periodontitis => "#7c3aed",
        ToothStateType.Bridge => "#d97706",
        ToothStateType.Missing or ToothStateType.Extracted => "#e5e7eb",
        _ => "#f9fafb"
    };
}
