@inject ApiClient Api
@inject ISnackbar Snackbar
@using DentalLocal.Shared.Contracts.Icd

<MudCard Class="mt-3 pa-3" Elevation="3">
    <MudCardHeader>
        <CardHeaderContent>
            @if (MultiToothNumbers is { Count: > 1 })
            {
                <MudText Typo="Typo.subtitle1">Зубы @string.Join(", ", MultiToothNumbers) — общий диагноз</MudText>
            }
            else
            {
                <MudText Typo="Typo.subtitle1">Зуб @ToothNumber, поверхность «@GetSurfaceName(SurfaceCode)»</MudText>
            }
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => OnClose?.Invoke()" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudSelect T="ToothStateType" @bind-Value="_status" Label="Статус/диагноз" Class="mb-3">
            @foreach (ToothStateType s in Enum.GetValues<ToothStateType>())
            {
                <MudSelectItem Value="s">@GetStateName(s)</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_diagnosis" Label="Диагноз (текст)" Class="mb-3" MaxLength="255" />

        <MudAutocomplete T="IcdCodeDto" Label="МКБ-10" @bind-Value="_icd10" SearchFunc="SearchIcd10Async"
                          ToStringFunc="@(x => x == null ? "" : $"{x.Code} — {x.Description}")"
                          ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="false" Class="mb-3" />

        <MudAutocomplete T="IcdCodeDto" Label="МКБ-11" @bind-Value="_icd11" SearchFunc="SearchIcd11Async"
                          ToStringFunc="@(x => x == null ? "" : $"{x.Code} — {x.Description}")"
                          ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="false" Class="mb-3" />

        <MudTextField @bind-Value="_comment" Label="Комментарий врача" Lines="2" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">
            @(_saving ? "Сохранение..." : "Применить")
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] public Guid PatientId { get; set; }
    [Parameter] public int ToothNumber { get; set; }
    [Parameter] public string SurfaceCode { get; set; } = "O";
    [Parameter] public ToothStateType CurrentState { get; set; }
    [Parameter] public Guid? VisitId { get; set; }
    [Parameter] public IReadOnlyList<int>? MultiToothNumbers { get; set; }
    [Parameter] public Func<Task>? OnStateSaved { get; set; }
    [Parameter] public Action? OnClose { get; set; }

    private ToothStateType _status;
    private string? _diagnosis;
    private IcdCodeDto? _icd10;
    private IcdCodeDto? _icd11;
    private string? _comment;
    private bool _saving;

    protected override void OnParametersSet()
    {
        _status = CurrentState;
    }

    private async Task<IEnumerable<IcdCodeDto>> SearchIcd10Async(string search, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(search) || search.Length < 2) return [];
        try { return await Api.SearchIcd10Async(search, ct); }
        catch { return []; }
    }

    private async Task<IEnumerable<IcdCodeDto>> SearchIcd11Async(string search, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(search) || search.Length < 2) return [];
        try { return await Api.SearchIcd11Async(search, ct); }
        catch { return []; }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var request = new AddToothSurfaceRecordRequest(
                SurfaceCode, _status, _diagnosis, _icd10?.Code, _icd11?.Code, VisitId, _comment);

            if (MultiToothNumbers is { Count: > 1 })
            {
                foreach (var toothNumber in MultiToothNumbers)
                    await Api.AddToothSurfaceRecordAsync(PatientId, (short)toothNumber, request);

                Snackbar.Add($"Диагноз применён к {MultiToothNumbers.Count} зубам.", Severity.Success);
            }
            else
            {
                await Api.AddToothSurfaceRecordAsync(PatientId, (short)ToothNumber, request);
                Snackbar.Add($"Зуб {ToothNumber} ({GetSurfaceName(SurfaceCode)}) обновлён.", Severity.Success);
            }

            if (OnStateSaved != null) await OnStateSaved();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string GetSurfaceName(string code) => code switch
    {
        "M" => "медиальная",
        "D" => "дистальная",
        "O" => "окклюзионная/режущая",
        "B" => "вестибулярная (щёчная)",
        "L" => "нёбная/язычная",
        _ => code
    };

    private static string GetStateName(ToothStateType state) => state switch
    {
        ToothStateType.Healthy => "Здоров",
        ToothStateType.Caries => "Кариес",
        ToothStateType.Filling => "Пломба",
        ToothStateType.Extracted => "Удалён",
        ToothStateType.Crown => "Коронка",
        ToothStateType.Implant => "Имплант",
        ToothStateType.Veneer => "Винир",
        ToothStateType.RootCanalTreated => "Лечение каналов",
        ToothStateType.Cracked => "Трещина",
        ToothStateType.Destroyed => "Разрушен",
        ToothStateType.Pulpitis => "Пульпит",
        ToothStateType.Periodontitis => "Периодонтит",
        ToothStateType.Bridge => "Мост",
        ToothStateType.Missing => "Отсутствует",
        _ => state.ToString()
    };
}
