@inject ApiClient Api
@inject ISnackbar Snackbar

<MudCard Class="mt-3 pa-3" Elevation="3">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1">Зуб @ToothNumber — @GetStateName(CurrentState)</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => OnClose?.Invoke()" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudSelect T="ToothStateType" @bind-Value="_newState" Label="Новое состояние" Class="mb-3">
            @foreach (ToothStateType s in Enum.GetValues<ToothStateType>())
            {
                <MudSelectItem Value="s">@GetStateName(s)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_comment" Label="Комментарий" Lines="2" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">
            @(_saving ? "Сохранение..." : "Применить")
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] public Guid PatientId { get; set; }
    [Parameter] public int ToothNumber { get; set; }
    [Parameter] public ToothStateType CurrentState { get; set; }
    [Parameter] public Guid? VisitId { get; set; }
    [Parameter] public Func<Task>? OnStateSaved { get; set; }
    [Parameter] public Action? OnClose { get; set; }

    private ToothStateType _newState;
    private string? _comment;
    private bool _saving;

    protected override void OnParametersSet()
    {
        _newState = CurrentState;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var request = new UpdateToothRequest((short)ToothNumber, _newState, VisitId, _comment);
            await Api.UpdateToothAsync(PatientId, (short)ToothNumber, request);
            Snackbar.Add($"Зуб {ToothNumber} обновлён.", Severity.Success);
            if (OnStateSaved != null) await OnStateSaved();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string GetStateName(ToothStateType state) => state switch
    {
        ToothStateType.Healthy => "Здоров",
        ToothStateType.Caries => "Кариес",
        ToothStateType.Filling => "Пломба",
        ToothStateType.Extracted => "Удалён",
        ToothStateType.Crown => "Коронка",
        ToothStateType.Implant => "Имплант",
        ToothStateType.Veneer => "Винир",
        ToothStateType.RootCanalTreated => "Лечение каналов",
        ToothStateType.Cracked => "Трещина",
        ToothStateType.Destroyed => "Разрушен",
        ToothStateType.Pulpitis => "Пульпит",
        ToothStateType.Periodontitis => "Периодонтит",
        ToothStateType.Bridge => "Мост",
        ToothStateType.Missing => "Отсутствует",
        _ => state.ToString()
    };
}
