@using DentalLocal.Shared.Enums

<div class="odontogram-legend mt-4 pa-2">
    <MudText Typo="Typo.subtitle2" Class="mb-2">Легенда обозначений</MudText>
    <div class="legend-grid">
        <div class="legend-item">
            <span class="legend-color" style="background-color: #f9fafb; border: 1px solid #d1d5db;"></span>
            <span class="legend-text">Здоровый</span>
        </div>
        <div class="legend-item">
            <span class="legend-color" style="background-color: #92400e;"></span>
            <span class="legend-text">Кариес</span>
        </div>
        <div class="legend-item">
            <span class="legend-color" style="background-color: #1d4ed8;"></span>
            <span class="legend-text">Пломба</span>
        </div>
        <div class="legend-item">
            <span class="legend-color" style="background-color: #b45309;"></span>
            <span class="legend-text">Коронка</span>
        </div>
        <div class="legend-item">
            <span class="legend-color" style="background-color: #6b7280;"></span>
            <span class="legend-text">Имплант</span>
        </div>
        <div class="legend-item">
            <span class="legend-color" style="background-color: #0891b2;"></span>
            <span class="legend-text">Винир</span>
        </div>
        <div class="legend-item">
            <span class="legend-color" style="background-color: #dc2626;"></span>
            <span class="legend-text">Каналы</span>
        </div>
        <div class="legend-item">
            <span class="legend-color" style="background-color: #ea580c;"></span>
            <span class="legend-text">Трещина</span>
        </div>
        <div class="legend-item text-danger">
            <span class="legend-color" style="background: repeating-linear-gradient(45deg, #e5e7eb, #e5e7eb 5px, #9ca3af 5px, #9ca3af 10px);"></span>
            <span class="legend-text">Удален / Отсутствует</span>
        </div>
    </div>
</div>

