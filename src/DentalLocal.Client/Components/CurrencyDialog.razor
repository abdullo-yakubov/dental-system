@using DentalLocal.Shared.Contracts.Currencies
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        @(IsEdit ? "Редактировать валюту" : "Добавить валюту")
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            @if (!IsEdit)
            {
                <MudTextField T="string" @bind-Value="_code" Label="Код (например USD, UZS)" Required="true" Class="mb-3" MaxLength="10" />
            }
            <MudTextField T="string" @bind-Value="_name" Label="Название" Required="true" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_symbol" Label="Символ" Required="true" Class="mb-3" />
            <MudNumericField T="decimal" @bind-Value="_exchangeRate" Label="Курс к базовой валюте" Required="true" Class="mb-3" Min="0.0001m" />
            <MudSwitch T="bool" @bind-Value="_isBase" Label="Сделать базовой валютой" Color="Color.Primary" />
        </MudForm>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_isBusy">
            @(_isBusy ? "Сохранение..." : "Сохранить")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public CurrencyDto? Existing { get; set; }

    private bool IsEdit => Existing is not null;

    private MudForm? _form;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private string _symbol = string.Empty;
    private decimal _exchangeRate = 1;
    private bool _isBase;

    private string? _errorMessage;
    private bool _isBusy;

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _code = Existing.Code;
            _name = Existing.Name;
            _symbol = Existing.Symbol;
            _exchangeRate = Existing.ExchangeRateToBase;
            _isBase = Existing.IsBase;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _isBusy = true;
        _errorMessage = null;

        try
        {
            CurrencyDto result;
            if (IsEdit)
            {
                result = await Api.UpdateCurrencyAsync(Existing!.Id, new UpdateCurrencyRequest(_name, _symbol, _exchangeRate, _isBase));
            }
            else
            {
                result = await Api.CreateCurrencyAsync(new CreateCurrencyRequest(_code, _name, _symbol, _exchangeRate, _isBase));
            }

            Snackbar.Add($"Валюта «{result.Code}» сохранена.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
