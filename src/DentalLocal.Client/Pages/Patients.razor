@page "/patients"
@attribute [Authorize]
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Пациенты — DentalLocal</PageTitle>

<div class="page-fade-in">
    <PageHeader Title="@Loc["Page_Patients_Title"]" Icon="@LucideIcons.Patients" Subtitle="@Loc["Patients_Subtitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@LucideIcons.UserPlus" OnClick="OpenCreateDialogAsync">
                @Loc["Patients_NewPatient"]
            </MudButton>
        </Actions>
    </PageHeader>

    <GlassCard Class="mb-4">
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
            <SearchBox Value="_search" OnSearch="OnSearchChanged" Placeholder="@Loc["Patients_SearchPlaceholder"]" Class="flex-grow-1" />
            <MudCheckBox T="bool" Value="_includeArchived" ValueChanged="OnIncludeArchivedChanged" Label="@Loc["Patients_ShowArchived"]" />
            <MudButton Variant="@(_showInactiveOnly ? Variant.Filled : Variant.Outlined)" Color="Color.Warning"
                       StartIcon="@LucideIcons.CalendarX" OnClick="ToggleInactiveFilterAsync">
                @Loc["Patients_InactiveFilter"]
            </MudButton>
        </MudStack>
    </GlassCard>

    <GlassCard Class="pa-0">
        @if (_showInactiveOnly)
        {
            <MudTable Items="_inactivePatients" Hover="true" Loading="_isLoading" Elevation="0" Class="glass-table">
                <HeaderContent>
                    <MudTh>@Loc["Patients_ColumnCardNumber"]</MudTh>
                    <MudTh>@Loc["Patients_ColumnFullName"]</MudTh>
                    <MudTh>@Loc["Patients_ColumnAge"]</MudTh>
                    <MudTh>@Loc["Common_ColumnPhone"]</MudTh>
                    <MudTh>@Loc["Patients_ColumnLastVisit"]</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Loc["Patients_ColumnCardNumber"]">@context.CardNumberDisplay</MudTd>
                    <MudTd DataLabel="@Loc["Patients_ColumnFullName"]">@context.FullName</MudTd>
                    <MudTd DataLabel="@Loc["Patients_ColumnAge"]">@context.Age</MudTd>
                    <MudTd DataLabel="@Loc["Common_ColumnPhone"]">@context.Phone</MudTd>
                    <MudTd DataLabel="@Loc["Patients_ColumnLastVisit"]">@(context.LastVisitAt?.ToString("dd.MM.yyyy") ?? Loc["Patients_NoVisitsYet"])</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" OnClick="@(() => OpenPatient(context.Id))">@Loc["Patients_Open"]</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@LucideIcons.CheckCircle" Title="@Loc["Patients_EmptyInactiveTitle"]"
                                Description="@Loc["Patients_EmptyInactiveDescription"]" />
                </NoRecordsContent>
            </MudTable>
        }
        else
        {
        <MudTable ServerData="LoadPatientsAsync" @ref="_table" Hover="true" Loading="_isLoading" Elevation="0" Class="glass-table">
            <HeaderContent>
                <MudTh>@Loc["Patients_ColumnCardNumber"]</MudTh>
                <MudTh>@Loc["Patients_ColumnFullName"]</MudTh>
                <MudTh>@Loc["Patients_ColumnAge"]</MudTh>
                <MudTh>@Loc["Common_ColumnPhone"]</MudTh>
                <MudTh>@Loc["Patients_ColumnLastVisit"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Loc["Patients_ColumnCardNumber"]">@context.CardNumberDisplay</MudTd>
                <MudTd DataLabel="@Loc["Patients_ColumnFullName"]">@context.FullName @(context.IsArchived ? Loc["Patients_ArchivedSuffix"] : "")</MudTd>
                <MudTd DataLabel="@Loc["Patients_ColumnAge"]">@context.Age</MudTd>
                <MudTd DataLabel="@Loc["Common_ColumnPhone"]">@context.Phone</MudTd>
                <MudTd DataLabel="@Loc["Patients_ColumnLastVisit"]">@(context.LastVisitAt?.ToString("dd.MM.yyyy") ?? "—")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" OnClick="@(() => OpenPatient(context.Id))">@Loc["Patients_Open"]</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@LucideIcons.UserSearch" Title="@Loc["Patients_EmptyTitle"]" Description="@Loc["Patients_EmptyDescription"]" />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="@Loc["Common_RowsPerPage"]" InfoFormat="@Loc["Common_PagerInfoFormat"]" />
            </PagerContent>
        </MudTable>
        }
    </GlassCard>
</div>

@code {
    private MudTable<PatientListItemDto>? _table;
    private string _search = string.Empty;
    private bool _includeArchived;
    private bool _isLoading;
    private bool _showInactiveOnly;
    private List<PatientListItemDto> _inactivePatients = [];

    private async Task<TableData<PatientListItemDto>> LoadPatientsAsync(TableState state, CancellationToken ct)
    {
        _isLoading = true;
        try
        {
            var result = await Api.SearchPatientsAsync(_search, _includeArchived, state.Page + 1, state.PageSize, ct);
            return new TableData<PatientListItemDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<PatientListItemDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await ReloadAsync();
    }

    private async Task OnIncludeArchivedChanged(bool value)
    {
        _includeArchived = value;
        await ReloadAsync();
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private async Task ToggleInactiveFilterAsync()
    {
        _showInactiveOnly = !_showInactiveOnly;

        if (_showInactiveOnly)
        {
            _isLoading = true;
            try
            {
                _inactivePatients = (await Api.GetInactivePatientsAsync(6)).ToList();
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                _inactivePatients = [];
            }
            finally
            {
                _isLoading = false;
            }
        }
    }

    private void OpenPatient(Guid id) => Navigation.NavigateTo($"/patients/{id}");

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<Components.CreatePatientDialog>(Loc["Patients_NewPatient"]);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }
}
