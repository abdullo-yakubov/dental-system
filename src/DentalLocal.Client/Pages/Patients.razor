@page "/patients"
@attribute [Authorize]
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Пациенты — DentalLocal</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Пациенты</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateDialogAsync">
        Новый пациент
    </MudButton>
</MudStack>

<MudStack Row="true" Spacing="4" Class="mb-4">
    <MudTextField T="string" Label="Поиск по ФИО, телефону, № карты" Adornment="Adornment.Start"
                   AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                   DebounceInterval="300" ValueChanged="OnSearchChanged" Value="_search" Class="flex-grow-1" />
    <MudCheckBox T="bool" Value="_includeArchived" ValueChanged="OnIncludeArchivedChanged" Label="Показать архивных" />
</MudStack>

<MudTable ServerData="LoadPatientsAsync" @ref="_table" Hover="true" Loading="_isLoading">
    <HeaderContent>
        <MudTh>№ карты</MudTh>
        <MudTh>ФИО</MudTh>
        <MudTh>Возраст</MudTh>
        <MudTh>Телефон</MudTh>
        <MudTh>Последний визит</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="№ карты">@context.CardNumberDisplay</MudTd>
        <MudTd DataLabel="ФИО">@context.FullName @(context.IsArchived ? "(архив)" : "")</MudTd>
        <MudTd DataLabel="Возраст">@context.Age</MudTd>
        <MudTd DataLabel="Телефон">@context.Phone</MudTd>
        <MudTd DataLabel="Последний визит">@(context.LastVisitAt?.ToString("dd.MM.yyyy") ?? "—")</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" OnClick="@(() => OpenPatient(context.Id))">Открыть</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Пациенты не найдены.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="На странице:" InfoFormat="{first_item}-{last_item} из {all_items}" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<PatientListItemDto>? _table;
    private string _search = string.Empty;
    private bool _includeArchived;
    private bool _isLoading;

    private async Task<TableData<PatientListItemDto>> LoadPatientsAsync(TableState state, CancellationToken ct)
    {
        _isLoading = true;
        try
        {
            var result = await Api.SearchPatientsAsync(_search, _includeArchived, state.Page + 1, state.PageSize, ct);
            return new TableData<PatientListItemDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<PatientListItemDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await ReloadAsync();
    }

    private async Task OnIncludeArchivedChanged(bool value)
    {
        _includeArchived = value;
        await ReloadAsync();
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private void OpenPatient(Guid id) => Navigation.NavigateTo($"/patients/{id}");

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<Components.CreatePatientDialog>("Новый пациент");
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }
}
