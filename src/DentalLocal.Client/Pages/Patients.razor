@page "/patients"
@attribute [Authorize]
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Пациенты — DentalLocal</PageTitle>

<div class="page-fade-in">
    <PageHeader Title="Пациенты" Icon="@Icons.Material.Filled.People" Subtitle="База пациентов клиники">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateDialogAsync">
                Новый пациент
            </MudButton>
        </Actions>
    </PageHeader>

    <GlassCard Class="mb-4">
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
            <SearchBox Value="_search" OnSearch="OnSearchChanged" Placeholder="Поиск по ФИО, телефону, № карты" Class="flex-grow-1" />
            <MudCheckBox T="bool" Value="_includeArchived" ValueChanged="OnIncludeArchivedChanged" Label="Показать архивных" />
            <MudButton Variant="@(_showInactiveOnly ? Variant.Filled : Variant.Outlined)" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.EventBusy" OnClick="ToggleInactiveFilterAsync">
                Отвалившиеся (6+ мес.)
            </MudButton>
        </MudStack>
    </GlassCard>

    <GlassCard Class="pa-0">
        @if (_showInactiveOnly)
        {
            <MudTable Items="_inactivePatients" Hover="true" Loading="_isLoading" Elevation="0" Class="glass-table">
                <HeaderContent>
                    <MudTh>№ карты</MudTh>
                    <MudTh>ФИО</MudTh>
                    <MudTh>Возраст</MudTh>
                    <MudTh>Телефон</MudTh>
                    <MudTh>Последний визит</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="№ карты">@context.CardNumberDisplay</MudTd>
                    <MudTd DataLabel="ФИО">@context.FullName</MudTd>
                    <MudTd DataLabel="Возраст">@context.Age</MudTd>
                    <MudTd DataLabel="Телефон">@context.Phone</MudTd>
                    <MudTd DataLabel="Последний визит">@(context.LastVisitAt?.ToString("dd.MM.yyyy") ?? "Не было визитов")</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" OnClick="@(() => OpenPatient(context.Id))">Открыть</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.CheckCircleOutline" Title="Отвалившихся пациентов нет"
                                Description="Все пациенты были на приёме в последние 6 месяцев." />
                </NoRecordsContent>
            </MudTable>
        }
        else
        {
        <MudTable ServerData="LoadPatientsAsync" @ref="_table" Hover="true" Loading="_isLoading" Elevation="0" Class="glass-table">
            <HeaderContent>
                <MudTh>№ карты</MudTh>
                <MudTh>ФИО</MudTh>
                <MudTh>Возраст</MudTh>
                <MudTh>Телефон</MudTh>
                <MudTh>Последний визит</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="№ карты">@context.CardNumberDisplay</MudTd>
                <MudTd DataLabel="ФИО">@context.FullName @(context.IsArchived ? "(архив)" : "")</MudTd>
                <MudTd DataLabel="Возраст">@context.Age</MudTd>
                <MudTd DataLabel="Телефон">@context.Phone</MudTd>
                <MudTd DataLabel="Последний визит">@(context.LastVisitAt?.ToString("dd.MM.yyyy") ?? "—")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" OnClick="@(() => OpenPatient(context.Id))">Открыть</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Filled.PersonSearch" Title="Пациенты не найдены" Description="Измените параметры поиска или добавьте нового пациента." />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="На странице:" InfoFormat="{first_item}-{last_item} из {all_items}" />
            </PagerContent>
        </MudTable>
        }
    </GlassCard>
</div>

@code {
    private MudTable<PatientListItemDto>? _table;
    private string _search = string.Empty;
    private bool _includeArchived;
    private bool _isLoading;
    private bool _showInactiveOnly;
    private List<PatientListItemDto> _inactivePatients = [];

    private async Task<TableData<PatientListItemDto>> LoadPatientsAsync(TableState state, CancellationToken ct)
    {
        _isLoading = true;
        try
        {
            var result = await Api.SearchPatientsAsync(_search, _includeArchived, state.Page + 1, state.PageSize, ct);
            return new TableData<PatientListItemDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<PatientListItemDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await ReloadAsync();
    }

    private async Task OnIncludeArchivedChanged(bool value)
    {
        _includeArchived = value;
        await ReloadAsync();
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private async Task ToggleInactiveFilterAsync()
    {
        _showInactiveOnly = !_showInactiveOnly;

        if (_showInactiveOnly)
        {
            _isLoading = true;
            try
            {
                _inactivePatients = (await Api.GetInactivePatientsAsync(6)).ToList();
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                _inactivePatients = [];
            }
            finally
            {
                _isLoading = false;
            }
        }
    }

    private void OpenPatient(Guid id) => Navigation.NavigateTo($"/patients/{id}");

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<Components.CreatePatientDialog>("Новый пациент");
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }
}
