@page "/inventory"
@attribute [Authorize]
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Склад и Материалы — DentalLocal</PageTitle>

<PageHeader Title="Склад материалов" Icon="@Icons.Material.Filled.Warehouse" Subtitle="Остатки, приход/расход, оповещения о низком запасе">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="(() => OpenCreateDialogAsync())">
            Добавить материал
        </MudButton>
    </Actions>
</PageHeader>

@if (_lowStockMaterials.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4 border-radius-8" Variant="Variant.Filled">
        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Низкий остаток материалов!</MudText>
        <div class="mt-1">
            @string.Join(", ", _lowStockMaterials.Select(m => $"{m.Name} ({m.QuantityInStock.ToString("N2")} {m.Unit})"))
        </div>
    </MudAlert>
}

<GlassCard Class="mb-4">
    <SearchBox Value="_search" OnSearch="OnSearchChanged" Placeholder="Поиск материала" />
</GlassCard>

<GlassCard Class="pa-0">
<MudTable Items="_materials" Hover="true" Loading="_isLoading" Elevation="0" Class="glass-table">
    <HeaderContent>
        <MudTh>Название</MudTh>
        <MudTh>Ед. изм.</MudTh>
        <MudTh>Остаток</MudTh>
        <MudTh>Порог алертов</MudTh>
        <MudTh>Цена за единицу</MudTh>
        <MudTh>Стоимость склада</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Название" Class="font-weight-bold">@context.Name</MudTd>
        <MudTd DataLabel="Ед. изм.">@context.Unit</MudTd>
        <MudTd DataLabel="Остаток">
            <span class="@(context.QuantityInStock <= context.MinStockThreshold ? "text-danger font-weight-bold" : "")">
                @context.QuantityInStock.ToString("N2")
            </span>
            @if (context.QuantityInStock <= context.MinStockThreshold)
            {
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" Class="ml-1" Style="vertical-align: middle;" />
            }
        </MudTd>
        <MudTd DataLabel="Порог алертов">@context.MinStockThreshold.ToString("N2")</MudTd>
        <MudTd DataLabel="Цена за единицу">@context.PricePerUnit.ToString("N0") сум</MudTd>
        <MudTd DataLabel="Стоимость склада">
            @((context.QuantityInStock * context.PricePerUnit).ToString("N0")) сум
        </MudTd>
        <MudTd>
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.SwapVert"
                           OnClick="@(() => OpenAdjustDialogAsync(context))">
                    Приход/Расход
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEditDialogAsync(context))" />
            </MudStack>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyState Icon="@Icons.Material.Filled.Inventory2" Title="Материалы не найдены" Description="Измените поиск или добавьте новый материал." />
    </NoRecordsContent>
</MudTable>
</GlassCard>

@code {
    private List<MaterialDto> _materials = [];
    private List<MaterialDto> _lowStockMaterials = [];
    private string _search = string.Empty;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var matTask = Api.GetMaterialsAsync(_search);
            var lowTask = Api.GetLowStockMaterialsAsync();

            await Task.WhenAll(matTask, lowTask);

            _materials = (await matTask).ToList();
            _lowStockMaterials = (await lowTask).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Ошибка загрузки склада: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await LoadDataAsync();
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<MaterialDialog>("Добавить материал", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialogAsync(MaterialDto material)
    {
        var parameters = new DialogParameters { { "Material", material } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<MaterialDialog>("Редактировать материал", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenAdjustDialogAsync(MaterialDto material)
    {
        var parameters = new DialogParameters { { "Material", material } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AdjustStockDialog>("Приход / Расход", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }
}
