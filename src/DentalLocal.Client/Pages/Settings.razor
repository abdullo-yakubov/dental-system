@page "/settings"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ThemeService ThemeService
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Настройки — DentalLocal</PageTitle>

<PageHeader Title="@Loc["Page_Settings_Title"]" Icon="@LucideIcons.Settings" Subtitle="@Loc["Settings_Subtitle"]" />

<div class="glass-card pa-2">
<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="@Loc["Settings_TabGeneral"]" Icon="@LucideIcons.SlidersHorizontal">
        @if (_settingsLoaded)
        {
            <MudStack Spacing="4" Style="max-width: 480px;">
                <MudTextField @bind-Value="_doctorName" Label="@Loc["Settings_DoctorName"]" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_clinicName" Label="@Loc["Settings_ClinicName"]" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_currency" Label="@Loc["Settings_Currency"]" Variant="Variant.Outlined" />
                <div>
                    <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">@Loc["Settings_ThemeLabel"]</MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary">
                            <MudButton StartIcon="@LucideIcons.Sun" Variant="@(ThemeService.IsDark ? Variant.Outlined : Variant.Filled)" OnClick="@(() => SetThemeModeAsync(false))">@Loc["Settings_ThemeLight"]</MudButton>
                            <MudButton StartIcon="@LucideIcons.Moon" Variant="@(ThemeService.IsDark ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetThemeModeAsync(true))">@Loc["Settings_ThemeDark"]</MudButton>
                        </MudButtonGroup>
                        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary">
                            <MudButton Variant="@(ThemeService.CustomAccentColor is null && ThemeService.Accent == AppAccent.Blue ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetThemeAccentAsync(AppAccent.Blue))">@Loc["Settings_AccentBlue"]</MudButton>
                            <MudButton Variant="@(ThemeService.CustomAccentColor is null && ThemeService.Accent == AppAccent.Teal ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetThemeAccentAsync(AppAccent.Teal))">@Loc["Settings_AccentTeal"]</MudButton>
                        </MudButtonGroup>
                    </MudStack>
                </div>
                <div>
                    <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">@Loc["Settings_CustomAccentLabel"]</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudColorPicker @bind-Text="_customAccentColor" Label="@Loc["Settings_ColorPickerLabel"]" Variant="Variant.Outlined"
                                        DisableToolbar="true" ColorPickerView="ColorPickerView.Palette" Style="width: 220px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyCustomAccentAsync">@Loc["Common_Apply"]</MudButton>
                        @if (ThemeService.CustomAccentColor is not null)
                        {
                            <MudButton Variant="Variant.Text" OnClick="ResetCustomAccentAsync">@Loc["Settings_ResetAccent"]</MudButton>
                        }
                    </MudStack>
                </div>
                <MudSelect T="string" @bind-Value="_language" Label="@Loc["Settings_LanguageLabel"]" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("ru")">Русский</MudSelectItem>
                    <MudSelectItem Value="@("tj")">Тоҷикӣ</MudSelectItem>
                    <MudSelectItem Value="@("en")">English</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_backupTime" Label="@Loc["Settings_BackupTimeLabel"]" Variant="Variant.Outlined" />
                <MudNumericField @bind-Value="_backupRetentionDays" Label="@Loc["Settings_BackupRetentionLabel"]" Variant="Variant.Outlined" Min="1" />
                <MudNumericField @bind-Value="_autoLockMinutes" Label="@Loc["Settings_AutoLockLabel"]" Variant="Variant.Outlined" Min="1" />
                <MudSwitch T="bool" @bind-Value="_enable3DOdontogram" Color="Color.Primary" Label="@Loc["Settings_Enable3DOdontogram"]" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync" Disabled="_isSavingSettings">
                    @Loc["Common_Save"]
                </MudButton>
            </MudStack>
        }
        else
        {
            <MudProgressCircular Indeterminate="true" />
        }
    </MudTabPanel>

    <MudTabPanel Text="@Loc["Settings_TabSecurity"]" Icon="@LucideIcons.Lock">
        <MudStack Spacing="4" Style="max-width: 480px;">
            <MudTextField @bind-Value="_oldCode" Label="@Loc["Settings_OldCodeLabel"]" Variant="Variant.Outlined" InputType="InputType.Password" />
            <MudTextField @bind-Value="_newCode" Label="@Loc["Settings_NewCodeLabel"]" Variant="Variant.Outlined" InputType="InputType.Password" />
            <MudTextField @bind-Value="_newCodeConfirm" Label="@Loc["Settings_NewCodeConfirmLabel"]" Variant="Variant.Outlined" InputType="InputType.Password" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangeCodeAsync" Disabled="_isChangingCode">
                @Loc["Settings_ChangeCodeButton"]
            </MudButton>
        </MudStack>
    </MudTabPanel>

    <MudTabPanel Text="@Loc["Settings_TabBackups"]" Icon="@LucideIcons.CloudUpload">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.subtitle1">@Loc["Settings_BackupsTitle"]</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@LucideIcons.Plus"
                       OnClick="OpenCreateBackupDialogAsync" Disabled="_isBackupJobRunning">
                @Loc["Settings_CreateBackupNow"]
            </MudButton>
        </MudStack>

        <MudTable Items="_backups" Hover="true" Loading="_isLoadingBackups" Elevation="0" Class="glass-table">
            <HeaderContent>
                <MudTh>@Loc["Settings_ColumnFile"]</MudTh>
                <MudTh>@Loc["Settings_ColumnCreated"]</MudTh>
                <MudTh>@Loc["Settings_ColumnSize"]</MudTh>
                <MudTh>@Loc["Settings_ColumnTrigger"]</MudTh>
                <MudTh>@Loc["Common_ColumnStatus"]</MudTh>
                <MudTh>@Loc["Settings_ColumnNote"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Loc["Settings_ColumnFile"]">@context.FileName</MudTd>
                <MudTd DataLabel="@Loc["Settings_ColumnCreated"]">@context.CreatedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</MudTd>
                <MudTd DataLabel="@Loc["Settings_ColumnSize"]">@FormatSize(context.SizeBytes)</MudTd>
                <MudTd DataLabel="@Loc["Settings_ColumnTrigger"]">@FormatTrigger(context.Trigger)</MudTd>
                <MudTd DataLabel="@Loc["Common_ColumnStatus"]">
                    @if (context.IsValid)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">@Loc["Settings_BackupValid"]</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">@Loc["Settings_BackupInvalid"]</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="@Loc["Settings_ColumnNote"]">@context.Note</MudTd>
                <MudTd>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@LucideIcons.ShieldCheck" Size="Size.Small" Color="Color.Info"
                                       OnClick="@(() => ValidateBackupAsync(context.FileName))" title="@Loc["Settings_ValidateBackupTitle"]" />
                        <MudIconButton Icon="@LucideIcons.RotateCcw" Size="Size.Small" Color="Color.Warning"
                                       OnClick="@(() => OpenRestoreDialogAsync(context.FileName))" Disabled="_isBackupJobRunning"
                                       title="@Loc["Settings_RestoreBackupTitle"]" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@LucideIcons.CloudUpload" Title="@Loc["Settings_NoBackups"]" />
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="@Loc["Settings_TabAuditLog"]" Icon="@LucideIcons.History">
        <MudTable Items="_auditLogs" Hover="true" Loading="_isLoadingAudit" Elevation="0" Class="glass-table">
            <HeaderContent>
                <MudTh>@Loc["Settings_ColumnDate"]</MudTh>
                <MudTh>@Loc["Settings_ColumnAction"]</MudTh>
                <MudTh>@Loc["Settings_ColumnEntity"]</MudTh>
                <MudTh>@Loc["Settings_ColumnDetails"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Loc["Settings_ColumnDate"]">@context.OccurredAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm:ss")</MudTd>
                <MudTd DataLabel="@Loc["Settings_ColumnAction"]">@context.Action</MudTd>
                <MudTd DataLabel="@Loc["Settings_ColumnEntity"]">@context.Entity</MudTd>
                <MudTd DataLabel="@Loc["Settings_ColumnDetails"]">@context.DetailsJson</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@LucideIcons.History" Title="@Loc["Settings_NoAuditLogs"]" />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 20, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="@Loc["Settings_TabSchedule"]" Icon="@LucideIcons.Clock">
        <MudText Typo="Typo.body2" Class="text-secondary mb-4">
            @Loc["Settings_ScheduleDescription"]
        </MudText>
        @if (_isLoadingSchedule)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            @foreach (var day in _weekDays)
            {
                var entry = _scheduleByDay[day];
                <MudPaper Class="pa-3 mb-2" Elevation="0" Style="background: var(--app-surface-alt, transparent);">
                    <MudGrid AlignItems="AlignItems.Center">
                        <MudItem xs="3">
                            <MudCheckBox T="bool" Value="entry.IsActive" ValueChanged="@(v => OnScheduleActiveChanged(day, v))" Label="@GetDayLabel(day)" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTimePicker Label="@Loc["Settings_ScheduleStart"]" Time="entry.StartTime.ToTimeSpan()" TimeChanged="@(t => OnScheduleTimeChanged(day, t, isStart: true))"
                                           Disabled="!entry.IsActive" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTimePicker Label="@Loc["Settings_ScheduleEnd"]" Time="entry.EndTime.ToTimeSpan()" TimeChanged="@(t => OnScheduleTimeChanged(day, t, isStart: false))"
                                           Disabled="!entry.IsActive" />
                        </MudItem>
                        <MudItem xs="1">
                            <MudIconButton Icon="@LucideIcons.Save" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => SaveScheduleDayAsync(day))" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        }
    </MudTabPanel>
</MudTabs>
</div>

@code {
    private bool _settingsLoaded;
    private bool _isSavingSettings;

    private string _doctorName = string.Empty;
    private string _clinicName = string.Empty;
    private string _currency = string.Empty;
    private string _theme = "system";
    private string _language = "ru";
    private string _backupTime = string.Empty;
    private int _backupRetentionDays = 30;
    private int _autoLockMinutes = 10;
    private bool _enable3DOdontogram;

    private string _oldCode = string.Empty;
    private string _newCode = string.Empty;
    private string _newCodeConfirm = string.Empty;
    private bool _isChangingCode;

    private List<BackupDto> _backups = [];
    private bool _isLoadingBackups = true;

    private List<AuditLogDto> _auditLogs = [];
    private bool _isLoadingAudit = true;


    private sealed class ScheduleDayEntry
    {
        public bool IsActive { get; set; }
        public TimeOnly StartTime { get; set; } = new(9, 0);
        public TimeOnly EndTime { get; set; } = new(18, 0);
    }

    private static readonly DayOfWeek[] _weekDays =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    ];

    private readonly Dictionary<DayOfWeek, ScheduleDayEntry> _scheduleByDay =
        _weekDays.ToDictionary(d => d, _ => new ScheduleDayEntry());

    private bool _isLoadingSchedule = true;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadSettingsAsync(), LoadBackupsAsync(), LoadAuditLogsAsync(), LoadScheduleAsync());
    }

    private string GetDayLabel(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => Loc["Settings_DayMonday"],
        DayOfWeek.Tuesday => Loc["Settings_DayTuesday"],
        DayOfWeek.Wednesday => Loc["Settings_DayWednesday"],
        DayOfWeek.Thursday => Loc["Settings_DayThursday"],
        DayOfWeek.Friday => Loc["Settings_DayFriday"],
        DayOfWeek.Saturday => Loc["Settings_DaySaturday"],
        _ => Loc["Settings_DaySunday"]
    };

    private async Task LoadScheduleAsync()
    {
        _isLoadingSchedule = true;
        try
        {
            var schedule = await Api.GetDoctorScheduleAsync();
            foreach (var s in schedule)
            {
                _scheduleByDay[s.DayOfWeek] = new ScheduleDayEntry
                {
                    IsActive = s.IsActive,
                    StartTime = s.StartTime,
                    EndTime = s.EndTime
                };
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Settings_ScheduleLoadFailed"], ex.Message), Severity.Error);
        }
        finally
        {
            _isLoadingSchedule = false;
        }
    }

    private void OnScheduleActiveChanged(DayOfWeek day, bool isActive) => _scheduleByDay[day].IsActive = isActive;

    private void OnScheduleTimeChanged(DayOfWeek day, TimeSpan? time, bool isStart)
    {
        if (time is null)
            return;

        var timeOnly = TimeOnly.FromTimeSpan(time.Value);
        if (isStart)
            _scheduleByDay[day].StartTime = timeOnly;
        else
            _scheduleByDay[day].EndTime = timeOnly;
    }

    private async Task SaveScheduleDayAsync(DayOfWeek day)
    {
        var entry = _scheduleByDay[day];
        if (entry.EndTime <= entry.StartTime)
        {
            Snackbar.Add(Loc["Settings_ScheduleTimeInvalid"], Severity.Error);
            return;
        }

        try
        {
            var request = new UpsertDoctorScheduleRequest(_doctorName, day, entry.StartTime, entry.EndTime, entry.IsActive);
            await Api.UpsertDoctorScheduleAsync(request);
            Snackbar.Add(string.Format(Loc["Settings_ScheduleSaved"], GetDayLabel(day).ToLower()), Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var settings = await Api.GetSettingsAsync();
            _doctorName = settings.DoctorName;
            _clinicName = settings.ClinicName;
            _currency = settings.Currency;
            _theme = settings.Theme;
            _language = settings.Language;
            _backupTime = settings.BackupTime;
            _backupRetentionDays = settings.BackupRetentionDays;
            _autoLockMinutes = settings.AutoLockMinutes;
            _enable3DOdontogram = settings.Enable3DOdontogram;
            _settingsLoaded = true;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Settings_LoadFailed"], ex.Message), Severity.Error);
        }
    }

    private string _customAccentColor = "#3E63DD";

    protected override void OnInitialized()
    {
        ThemeService.Changed += OnThemeChanged;
        _customAccentColor = ThemeService.CustomAccentColor ?? "#3E63DD";
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    void IDisposable.Dispose() => ThemeService.Changed -= OnThemeChanged;

    private async Task SetThemeModeAsync(bool isDark)
    {
        if (ThemeService.IsDark != isDark)
            await ThemeService.ToggleModeAsync();
    }

    private async Task SetThemeAccentAsync(AppAccent accent)
    {
        if (ThemeService.CustomAccentColor is not null)
            await ThemeService.ResetCustomAccentAsync();

        await ThemeService.SetAccentAsync(accent);
    }

    private async Task ApplyCustomAccentAsync()
    {
        if (string.IsNullOrWhiteSpace(_customAccentColor))
        {
            Snackbar.Add(Loc["Settings_ColorRequired"], Severity.Warning);
            return;
        }

        await ThemeService.SetCustomAccentAsync(_customAccentColor);
        Snackbar.Add(Loc["Settings_AccentApplied"], Severity.Success);
    }

    private async Task ResetCustomAccentAsync()
    {
        await ThemeService.ResetCustomAccentAsync();
        _customAccentColor = "#3E63DD";
    }

    private async Task SaveSettingsAsync()
    {
        _isSavingSettings = true;
        try
        {
            var languageChanged = _language != await CultureService.GetStoredCultureAsync(JsRuntime);

            _theme = $"{(ThemeService.IsDark ? "dark" : "light")}-{(ThemeService.Accent == AppAccent.Teal ? "teal" : "blue")}";
            var request = new UpdateSettingsRequest(
                _doctorName, _clinicName, _currency, _theme, _language, _backupTime, _backupRetentionDays,
                _autoLockMinutes, _enable3DOdontogram);

            var settings = await Api.UpdateSettingsAsync(request);
            _doctorName = settings.DoctorName;
            _clinicName = settings.ClinicName;
            _currency = settings.Currency;
            _theme = settings.Theme;
            _language = settings.Language;
            _backupTime = settings.BackupTime;
            _backupRetentionDays = settings.BackupRetentionDays;
            _autoLockMinutes = settings.AutoLockMinutes;
            _enable3DOdontogram = settings.Enable3DOdontogram;

            if (languageChanged)
            {
                await CultureService.SetStoredCultureAsync(JsRuntime, _language);
                Snackbar.Add(Loc["Settings_SavedApplyingLanguage"], Severity.Success);
                Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
                return;
            }

            Snackbar.Add(Loc["Settings_Saved"], Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Settings_SaveFailed"], ex.Message), Severity.Error);
        }
        finally
        {
            _isSavingSettings = false;
        }
    }

    private async Task ChangeCodeAsync()
    {
        if (_newCode != _newCodeConfirm)
        {
            Snackbar.Add(Loc["Settings_CodeMismatch"], Severity.Warning);
            return;
        }

        _isChangingCode = true;
        try
        {
            await Api.ChangeAccessCodeAsync(_oldCode, _newCode);
            Snackbar.Add(Loc["Settings_CodeChanged"], Severity.Success);
            _oldCode = _newCode = _newCodeConfirm = string.Empty;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Settings_ChangeCodeFailed"], ex.Message), Severity.Error);
        }
        finally
        {
            _isChangingCode = false;
        }
    }

    private async Task LoadBackupsAsync()
    {
        _isLoadingBackups = true;
        try
        {
            _backups = (await Api.GetBackupsAsync()).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Settings_BackupsLoadFailed"], ex.Message), Severity.Error);
        }
        finally
        {
            _isLoadingBackups = false;
        }
    }

    private async Task LoadAuditLogsAsync()
    {
        _isLoadingAudit = true;
        try
        {
            var result = await Api.GetAuditLogsAsync(1, 50);
            _auditLogs = result.Items.ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Settings_AuditLoadFailed"], ex.Message), Severity.Error);
        }
        finally
        {
            _isLoadingAudit = false;
        }
    }

    private bool _isBackupJobRunning;

    private async Task OpenCreateBackupDialogAsync()
    {
        var pin = await PromptPinAsync();
        if (string.IsNullOrWhiteSpace(pin))
            return;

        try
        {
            var jobId = await Api.CreateBackupAsync(new CreateBackupRequest(pin, "Ручное создание"));
            Snackbar.Add(Loc["Settings_BackupInProgress"], Severity.Info);

            var job = await WaitForJobAsync(jobId);
            if (job.Status == "Succeeded")
            {
                Snackbar.Add(Loc["Settings_BackupCreated"], Severity.Success);
            }
            else
            {
                Snackbar.Add(string.Format(Loc["Settings_BackupJobFailed"], job.Error), Severity.Error);
            }

            await LoadBackupsAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Settings_BackupCreateFailed"], ex.Message), Severity.Error);
        }
    }

    private async Task OpenRestoreDialogAsync(string fileName)
    {
        var pin = await PromptPinAsync();
        if (string.IsNullOrWhiteSpace(pin))
            return;

        try
        {
            var jobId = await Api.RestoreBackupAsync(new RestoreBackupRequest(pin, fileName));
            Snackbar.Add(Loc["Settings_BackupInProgress"], Severity.Info);

            var job = await WaitForJobAsync(jobId);
            if (job.Status == "Succeeded")
            {
                Snackbar.Add(Loc["Settings_BackupRestored"], Severity.Success);
            }
            else
            {
                Snackbar.Add(string.Format(Loc["Settings_BackupJobFailed"], job.Error), Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Settings_BackupRestoreFailed"], ex.Message), Severity.Error);
        }
    }

    // Опрос статуса фоновой джобы (backup/restore) раз в 2 секунды — операция не блокирует HTTP-запрос,
    // поэтому UI ждёт результата отдельным поллингом вместо долгого await на POST (см. промпт 6 аудита).
    private async Task<JobDto> WaitForJobAsync(Guid jobId)
    {
        _isBackupJobRunning = true;
        StateHasChanged();

        try
        {
            var deadline = DateTime.UtcNow.AddMinutes(10);
            while (DateTime.UtcNow < deadline)
            {
                var job = await Api.GetJobAsync(jobId);
                if (job.Status is "Succeeded" or "Failed")
                    return job;

                await Task.Delay(2000);
            }

            return new JobDto(jobId, "unknown", "Failed", 0, "Превышено время ожидания.", DateTime.UtcNow, DateTime.UtcNow);
        }
        finally
        {
            _isBackupJobRunning = false;
            StateHasChanged();
        }
    }

    private async Task ValidateBackupAsync(string fileName)
    {
        try
        {
            var isValid = await Api.ValidateBackupAsync(fileName);
            Snackbar.Add(isValid ? Loc["Settings_BackupValidOk"] : Loc["Settings_BackupCorrupted"], isValid ? Severity.Success : Severity.Error);
            await LoadBackupsAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Settings_BackupValidateFailed"], ex.Message), Severity.Error);
        }
    }

    private async Task<string?> PromptPinAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PinPromptDialog>(Loc["Login_EnterCode"], options);
        var result = await dialog.Result;

        return result is { Canceled: false, Data: string pin } ? pin : null;
    }

    private string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / (1024.0 * 1024.0):N1} {Loc["Settings_UnitMb"]}";
        if (bytes >= 1024)
            return $"{bytes / 1024.0:N1} {Loc["Settings_UnitKb"]}";
        return $"{bytes} {Loc["Settings_UnitByte"]}";
    }

    private string FormatTrigger(short trigger) => trigger switch
    {
        1 => Loc["Settings_TriggerDaily"],
        2 => Loc["Settings_TriggerBeforeUpdate"],
        3 => Loc["Settings_TriggerManual"],
        4 => Loc["Settings_TriggerBeforeRestore"],
        _ => "—",
    };
}
