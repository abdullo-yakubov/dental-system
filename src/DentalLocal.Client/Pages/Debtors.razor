@page "/debtors"
@attribute [Authorize]
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Долги и Оплаты — DentalLocal</PageTitle>

<PageHeader Title="@Loc["Page_Debtors_Title"]" Icon="@LucideIcons.Debtors" Subtitle="@Loc["Debtors_Subtitle"]">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@LucideIcons.Download"
                   OnClick="ExportToExcelAsync" Disabled="_isExporting">
            @Loc["Common_Export"]
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@LucideIcons.UserPlus" OnClick="OpenCreatePatientDialogAsync">
            @Loc["Debtors_AddPatient"]
        </MudButton>
    </Actions>
</PageHeader>

<GlassCard Class="mb-4">
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
        <SearchBox Value="_search" OnSearch="OnSearchChanged" Placeholder="@Loc["Debtors_SearchPlaceholder"]" Class="flex-grow-1" />
        <MudSelect T="DebtStatus?" Value="_status" ValueChanged="OnStatusChanged" Label="@Loc["Debtors_StatusLabel"]" Class="flex-grow-0" Style="width: 200px;">
            <MudSelectItem Value="((DebtStatus?)null)">@Loc["Debtors_StatusAll"]</MudSelectItem>
            <MudSelectItem Value="((DebtStatus?)DebtStatus.Open)">@Loc["Debtors_StatusOpen"]</MudSelectItem>
            <MudSelectItem Value="((DebtStatus?)DebtStatus.Closed)">@Loc["Debtors_StatusClosed"]</MudSelectItem>
        </MudSelect>
    </MudStack>
</GlassCard>

<GlassCard Class="pa-0">
<MudTable ServerData="LoadDebtsAsync" @ref="_table" Hover="true" Loading="_isLoading" Elevation="0" Class="glass-table">
    <HeaderContent>
        <MudTh>@Loc["Debtors_ColumnPatient"]</MudTh>
        <MudTh>@Loc["Common_ColumnPhone"]</MudTh>
        <MudTh>@Loc["Debtors_ColumnBirthDate"]</MudTh>
        <MudTh>@Loc["Debtors_ColumnDebtAmount"]</MudTh>
        <MudTh>@Loc["Debtors_ColumnAge"]</MudTh>
        <MudTh>@Loc["Common_ColumnStatus"]</MudTh>
        <MudTh>@Loc["Debtors_ColumnDetails"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@Loc["Debtors_ColumnPatient"]">@context.PatientFullName</MudTd>
        <MudTd DataLabel="@Loc["Common_ColumnPhone"]">@context.PatientPhone</MudTd>
        <MudTd DataLabel="@Loc["Debtors_ColumnBirthDate"]">@context.PatientBirthDate.ToString("dd.MM.yyyy")</MudTd>
        <MudTd DataLabel="@Loc["Debtors_ColumnDebtAmount"]">
            <span class="@(context.RemainingAmount > 0 ? "text-danger font-weight-bold" : "text-success")">
                @context.RemainingAmount.ToString("N0") @Loc["Dashboard_Currency"]
            </span>
        </MudTd>
        <MudTd DataLabel="@Loc["Debtors_ColumnAge"]">
            <MudChip T="string" Color="@GetAgeColor(context.AroseAt)" Size="Size.Small">
                @GetAgeDays(context.AroseAt) @Loc["Debtors_DaysSuffix"]
            </MudChip>
        </MudTd>
        <MudTd DataLabel="@Loc["Common_ColumnStatus"]">
            <MudChip T="string" Color="@(context.Status == DebtStatus.Open ? Color.Error : Color.Success)" Size="Size.Small">
                @(context.Status == DebtStatus.Open ? Loc["Debtors_ChipOpen"] : Loc["Debtors_ChipClosed"])
            </MudChip>
        </MudTd>
        <MudTd DataLabel="@Loc["Debtors_ColumnDetails"]">
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => OpenPatient(context.PatientId))">
                    @Loc["Debtors_ColumnDetails"]
                </MudButton>
                @if (context.Status == DebtStatus.Open)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@LucideIcons.Wallet"
                               OnClick="@(() => PayDebtAsync(context))">
                        @Loc["Debtors_PayButton"]
                    </MudButton>
                }
            </MudStack>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyState Icon="@LucideIcons.CheckCircle" Title="@Loc["Debtors_EmptyTitle"]" Description="@Loc["Debtors_EmptyDescription"]" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="@Loc["Common_RowsPerPage"]" InfoFormat="@Loc["Common_PagerInfoFormat"]" />
    </PagerContent>
</MudTable>
</GlassCard>

@code {
    private MudTable<DebtListItemDto>? _table;
    private string _search = string.Empty;
    private DebtStatus? _status = DebtStatus.Open; // Default show only active debts
    private bool _isLoading;
    private bool _isExporting;

    private async Task ExportToExcelAsync()
    {
        _isExporting = true;
        try
        {
            var bytes = await Api.ExportDebtorsExcelAsync();
            var base64 = Convert.ToBase64String(bytes);
            await JsRuntime.InvokeVoidAsync("dentalLocal.downloadFileFromBytes", base64, "Должники.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(string.Format(Loc["Debtors_ExportFailed"], ex.Message), Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task<TableData<DebtListItemDto>> LoadDebtsAsync(TableState state, CancellationToken ct)
    {
        _isLoading = true;
        try
        {
            var result = await Api.SearchDebtsAsync(_status, _search, state.Page + 1, state.PageSize, ct);
            return new TableData<DebtListItemDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<DebtListItemDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await ReloadAsync();
    }

    private async Task OnStatusChanged(DebtStatus? value)
    {
        _status = value;
        await ReloadAsync();
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private async Task PayDebtAsync(DebtListItemDto debt)
    {
        var parameters = new DialogParameters
        {
            { "VisitId", debt.VisitId },
            { "PatientId", debt.PatientId },
            { "RemainingAmount", debt.RemainingAmount },
            { "InitialKind", PaymentKind.DebtRepayment }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RegisterPaymentDialog>(Loc["Debtors_PayDialogTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private void OpenPatient(Guid patientId) => Navigation.NavigateTo($"/patients/{patientId}");

    private async Task OpenCreatePatientDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<Components.CreatePatientDialog>(Loc["Patients_NewPatient"]);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private static int GetAgeDays(DateTimeOffset aroseAt) =>
        Math.Max(0, (int)(DateTimeOffset.UtcNow - aroseAt).TotalDays);

    private static Color GetAgeColor(DateTimeOffset aroseAt)
    {
        var days = GetAgeDays(aroseAt);
        return days switch
        {
            <= 30 => Color.Warning,
            > 90 => Color.Error,
            _ => Color.Default
        };
    }
}
