@page "/debtors"
@attribute [Authorize]
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Долги и Оплаты — DentalLocal</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Должники</MudText>
</MudStack>

<MudStack Row="true" Spacing="4" Class="mb-4">
    <MudTextField T="string" Label="Поиск по ФИО пациента или телефону" Adornment="Adornment.Start"
                   AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                   DebounceInterval="300" ValueChanged="OnSearchChanged" Value="_search" Class="flex-grow-1" />
    <MudSelect T="DebtStatus?" Value="_status" ValueChanged="OnStatusChanged" Label="Статус долга" Class="flex-grow-0" Style="width: 200px;">
        <MudSelectItem Value="((DebtStatus?)null)">Все долги</MudSelectItem>
        <MudSelectItem Value="((DebtStatus?)DebtStatus.Open)">Открытые</MudSelectItem>
        <MudSelectItem Value="((DebtStatus?)DebtStatus.Closed)">Погашенные</MudSelectItem>
    </MudSelect>
</MudStack>

<MudTable ServerData="LoadDebtsAsync" @ref="_table" Hover="true" Loading="_isLoading">
    <HeaderContent>
        <MudTh>Пациент</MudTh>
        <MudTh>Телефон</MudTh>
        <MudTh>Дата визита</MudTh>
        <MudTh>Сумма долга</MudTh>
        <MudTh>Остаток</MudTh>
        <MudTh>Статус</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Пациент">@context.PatientFullName</MudTd>
        <MudTd DataLabel="Телефон">@context.PatientPhone</MudTd>
        <MudTd DataLabel="Дата визита">@context.VisitDate.ToString("dd.MM.yyyy")</MudTd>
        <MudTd DataLabel="Сумма долга">@context.OriginalAmount.ToString("N0") сум</MudTd>
        <MudTd DataLabel="Остаток">
            <span class="@(context.RemainingAmount > 0 ? "text-danger font-weight-bold" : "text-success")">
                @context.RemainingAmount.ToString("N0") сум
            </span>
        </MudTd>
        <MudTd DataLabel="Статус">
            <MudChip T="string" Color="@(context.Status == DebtStatus.Open ? Color.Error : Color.Success)" Size="Size.Small">
                @(context.Status == DebtStatus.Open ? "Открыт" : "Погашен")
            </MudChip>
        </MudTd>
        <MudTd>
            @if (context.Status == DebtStatus.Open)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Payments"
                           OnClick="@(() => PayDebtAsync(context))">
                    Оплатить
                </MudButton>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Долги не найдены.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="На странице:" InfoFormat="{first_item}-{last_item} из {all_items}" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<DebtListItemDto>? _table;
    private string _search = string.Empty;
    private DebtStatus? _status = DebtStatus.Open; // Default show only active debts
    private bool _isLoading;

    private async Task<TableData<DebtListItemDto>> LoadDebtsAsync(TableState state, CancellationToken ct)
    {
        _isLoading = true;
        try
        {
            var result = await Api.SearchDebtsAsync(_status, _search, state.Page + 1, state.PageSize, ct);
            return new TableData<DebtListItemDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<DebtListItemDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await ReloadAsync();
    }

    private async Task OnStatusChanged(DebtStatus? value)
    {
        _status = value;
        await ReloadAsync();
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private async Task PayDebtAsync(DebtListItemDto debt)
    {
        var parameters = new DialogParameters
        {
            { "VisitId", debt.VisitId },
            { "PatientId", debt.PatientId },
            { "RemainingAmount", debt.RemainingAmount },
            { "InitialKind", PaymentKind.DebtRepayment }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RegisterPaymentDialog>("Погашение долга", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }
}
