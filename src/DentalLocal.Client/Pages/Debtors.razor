@page "/debtors"
@attribute [Authorize]
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Долги и Оплаты — DentalLocal</PageTitle>

<PageHeader Title="Должники" Icon="@Icons.Material.Filled.MoneyOff" Subtitle="Задолженности пациентов и их погашение">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreatePatientDialogAsync">
            Добавить пациента
        </MudButton>
    </Actions>
</PageHeader>

<GlassCard Class="mb-4">
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
        <SearchBox Value="_search" OnSearch="OnSearchChanged" Placeholder="Поиск по ФИО пациента или телефону" Class="flex-grow-1" />
        <MudSelect T="DebtStatus?" Value="_status" ValueChanged="OnStatusChanged" Label="Статус долга" Class="flex-grow-0" Style="width: 200px;">
            <MudSelectItem Value="((DebtStatus?)null)">Все долги</MudSelectItem>
            <MudSelectItem Value="((DebtStatus?)DebtStatus.Open)">Открытые</MudSelectItem>
            <MudSelectItem Value="((DebtStatus?)DebtStatus.Closed)">Погашенные</MudSelectItem>
        </MudSelect>
    </MudStack>
</GlassCard>

<GlassCard Class="pa-0">
<MudTable ServerData="LoadDebtsAsync" @ref="_table" Hover="true" Loading="_isLoading" Elevation="0" Class="glass-table">
    <HeaderContent>
        <MudTh>Пациент</MudTh>
        <MudTh>Телефон</MudTh>
        <MudTh>Дата рождения</MudTh>
        <MudTh>Сумма долга</MudTh>
        <MudTh>Давность</MudTh>
        <MudTh>Статус</MudTh>
        <MudTh>Подробнее</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Пациент">@context.PatientFullName</MudTd>
        <MudTd DataLabel="Телефон">@context.PatientPhone</MudTd>
        <MudTd DataLabel="Дата рождения">@context.PatientBirthDate.ToString("dd.MM.yyyy")</MudTd>
        <MudTd DataLabel="Сумма долга">
            <span class="@(context.RemainingAmount > 0 ? "text-danger font-weight-bold" : "text-success")">
                @context.RemainingAmount.ToString("N0") сум
            </span>
        </MudTd>
        <MudTd DataLabel="Давность">
            <MudChip T="string" Color="@GetAgeColor(context.AroseAt)" Size="Size.Small">
                @GetAgeDays(context.AroseAt) дн.
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Статус">
            <MudChip T="string" Color="@(context.Status == DebtStatus.Open ? Color.Error : Color.Success)" Size="Size.Small">
                @(context.Status == DebtStatus.Open ? "Открыт" : "Погашен")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Подробнее">
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => OpenPatient(context.PatientId))">
                    Подробнее
                </MudButton>
                @if (context.Status == DebtStatus.Open)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Payments"
                               OnClick="@(() => PayDebtAsync(context))">
                        Оплатить
                    </MudButton>
                }
            </MudStack>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyState Icon="@Icons.Material.Filled.CheckCircleOutline" Title="Долги не найдены" Description="Все пациенты рассчитались, либо измените фильтр." />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="На странице:" InfoFormat="{first_item}-{last_item} из {all_items}" />
    </PagerContent>
</MudTable>
</GlassCard>

@code {
    private MudTable<DebtListItemDto>? _table;
    private string _search = string.Empty;
    private DebtStatus? _status = DebtStatus.Open; // Default show only active debts
    private bool _isLoading;

    private async Task<TableData<DebtListItemDto>> LoadDebtsAsync(TableState state, CancellationToken ct)
    {
        _isLoading = true;
        try
        {
            var result = await Api.SearchDebtsAsync(_status, _search, state.Page + 1, state.PageSize, ct);
            return new TableData<DebtListItemDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<DebtListItemDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await ReloadAsync();
    }

    private async Task OnStatusChanged(DebtStatus? value)
    {
        _status = value;
        await ReloadAsync();
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private async Task PayDebtAsync(DebtListItemDto debt)
    {
        var parameters = new DialogParameters
        {
            { "VisitId", debt.VisitId },
            { "PatientId", debt.PatientId },
            { "RemainingAmount", debt.RemainingAmount },
            { "InitialKind", PaymentKind.DebtRepayment }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RegisterPaymentDialog>("Погашение долга", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private void OpenPatient(Guid patientId) => Navigation.NavigateTo($"/patients/{patientId}");

    private async Task OpenCreatePatientDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<Components.CreatePatientDialog>("Новый пациент");
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private static int GetAgeDays(DateTimeOffset aroseAt) =>
        Math.Max(0, (int)(DateTimeOffset.UtcNow - aroseAt).TotalDays);

    private static Color GetAgeColor(DateTimeOffset aroseAt)
    {
        var days = GetAgeDays(aroseAt);
        return days switch
        {
            <= 30 => Color.Warning,
            > 90 => Color.Error,
            _ => Color.Default
        };
    }
}
