@page "/procedures"
@attribute [Authorize]
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Каталог процедур — DentalLocal</PageTitle>

<PageHeader Title="@Loc["Page_Procedures_Title"]" Icon="@LucideIcons.Procedures" Subtitle="Процедуры и категории" />

<div class="glass-card pa-2">
<MudTabs Elevation="0" Rounded="true" ApplyEffectsToInnerViews="true" PanelClass="pa-4">
    <!-- Procedures Tab -->
    <MudTabPanel Text="Услуги и Процедуры">
        <MudStack Spacing="4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">Каталог услуг</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@LucideIcons.Plus"
                           OnClick="() => OpenProcedureCreateAsync()" Disabled="_loading">
                    Добавить процедуру
                </MudButton>
            </MudStack>

            <MudStack Row="true">
                <MudCheckBox T="bool" @bind-Value="_includeInactive" Label="Показать неактивные" Color="Color.Primary"
                             CheckChanged="LoadDataAsync" />
            </MudStack>

            <MudTable Items="_procedures" Hover="true" Loading="_loading" Elevation="0" Class="glass-table">
                <HeaderContent>
                    <MudTh>Название</MudTh>
                    <MudTh>Категория</MudTh>
                    <MudTh>Длительность</MudTh>
                    <MudTh>Стоимость</MudTh>
                    <MudTh>Статус</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Название" Class="font-weight-bold">@context.Name</MudTd>
                    <MudTd DataLabel="Категория">
                        <MudChip T="string" Color="Color.Default" Style="@($"background-color: {GetCategoryColor(context.CategoryId)}; color: #fff;")" Size="Size.Small">
                            @context.CategoryName
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Длительность">@context.DurationMinutes мин</MudTd>
                    <MudTd DataLabel="Стоимость">@context.Price.ToString("N0") сомони</MudTd>
                    <MudTd DataLabel="Статус">
                        <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                            @(context.IsActive ? "Активна" : "Неактивна")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@LucideIcons.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OpenProcedureEditAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@LucideIcons.Procedures" Title="Процедуры не найдены" />
                </NoRecordsContent>
            </MudTable>
        </MudStack>
    </MudTabPanel>

    <!-- Categories Tab -->
    <MudTabPanel Text="Категории">
        <MudStack Spacing="4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">Категории процедур</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@LucideIcons.Plus"
                           OnClick="() => OpenCategoryCreateAsync()" Disabled="_loading">
                    Добавить категорию
                </MudButton>
            </MudStack>

            <MudTable Items="_categories" Hover="true" Loading="_loading" Elevation="0" Class="glass-table">
                <HeaderContent>
                    <MudTh>Название категории</MudTh>
                    <MudTh>Цвет для календаря</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Название категории" Class="font-weight-bold">@context.Name</MudTd>
                    <MudTd DataLabel="Цвет для календаря">
                        <MudChip T="string" Style="@($"background-color: {context.Color}; color: #fff; width: 120px; text-align: center;")" Size="Size.Small">
                            @context.Color
                        </MudChip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@LucideIcons.Tag" Title="Категории не найдены" />
                </NoRecordsContent>
            </MudTable>
        </MudStack>
    </MudTabPanel>
</MudTabs>
</div>

@code {
    private List<ProcedureDto> _procedures = [];
    private List<ProcedureCategoryDto> _categories = [];
    private bool _includeInactive;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var catTask = Api.GetProcedureCategoriesAsync();
            var procTask = Api.GetProceduresAsync(_includeInactive);

            await Task.WhenAll(catTask, procTask);

            _categories = (await catTask).ToList();
            _procedures = (await procTask).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Ошибка загрузки справочников: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetCategoryColor(Guid? categoryId)
    {
        if (categoryId == null) return "#9CA3AF";
        var category = _categories.FirstOrDefault(c => c.Id == categoryId);
        return category?.Color ?? "#9CA3AF"; // Default grey if not found
    }

    private async Task OpenProcedureCreateAsync()
    {
        var parameters = new DialogParameters 
        { 
            { "Categories", _categories } 
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProcedureDialog>("Добавить процедуру", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenProcedureEditAsync(ProcedureDto procedure)
    {
        var parameters = new DialogParameters 
        { 
            { "Procedure", procedure },
            { "Categories", _categories }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProcedureDialog>("Редактировать процедуру", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenCategoryCreateAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProcedureCategoryDialog>("Добавить категорию", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }
}
