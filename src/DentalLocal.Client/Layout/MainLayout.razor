@inherits LayoutComponentBase
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject ThemeService ThemeService
@implements IDisposable

<MudThemeProvider Theme="ThemeService.CurrentTheme" IsDarkMode="ThemeService.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (AuthState.IsAuthenticated)
{
    <MudLayout Class="app-shell">
        <MudAppBar Elevation="0" Class="app-bar-glass">
            <img src="logo.jpg" alt="Logo" style="height: 36px; width: 36px; border-radius: 50%; object-fit: cover; margin-right: 12px; border: 2px solid rgba(255,255,255,0.2);" />
            <MudText Typo="Typo.h6">DentalLocal</MudText>
            <MudSpacer />
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mr-4">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Inherit" Style="opacity:0.7" />
                <MudText Typo="Typo.body1" Class="font-weight-bold" Style="font-variant-numeric: tabular-nums;">@_now.ToString("HH:mm:ss")</MudText>
                <MudText Typo="Typo.caption" Style="opacity:0.7">@_now.ToString("dd.MM.yyyy")</MudText>
            </MudStack>
            <MudTooltip Text="@(ThemeService.Accent == AppAccent.Blue ? "Акцент: синий" : "Акцент: бирюзовый")">
                <MudIconButton Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" OnClick="ToggleAccent" />
            </MudTooltip>
            <MudTooltip Text="@(ThemeService.IsDark ? "Светлая тема" : "Тёмная тема")">
                <MudIconButton Icon="@(ThemeService.IsDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleMode" />
            </MudTooltip>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" title="Выход" />
        </MudAppBar>
        <MudDrawer Open="true" Elevation="0" Variant="DrawerVariant.Persistent" Class="app-drawer-glass">
            <NavMenu />
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
                <div class="page-fade-in" @key="Navigation.Uri">
                    @Body
                </div>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else
{
    <div class="page-fade-in" @key="Navigation.Uri">
        @Body
    </div>
}

@code {
    private DateTime _now = DateTime.Now;
    private System.Threading.Timer? _clockTimer;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.Changed += OnThemeChanged;
        AuthState.Changed += OnThemeChanged;
        await ThemeService.InitializeAsync();

        _clockTimer = new System.Threading.Timer(_ =>
        {
            _now = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private Task ToggleMode() => ThemeService.ToggleModeAsync();

    private Task ToggleAccent() => ThemeService.SetAccentAsync(
        ThemeService.Accent == AppAccent.Blue ? AppAccent.Teal : AppAccent.Blue);

    private void Logout()
    {
        AuthState.Clear();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        ThemeService.Changed -= OnThemeChanged;
        AuthState.Changed -= OnThemeChanged;
        _clockTimer?.Dispose();
    }
}
