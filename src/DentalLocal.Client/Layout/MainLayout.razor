@inherits LayoutComponentBase
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject ThemeService ThemeService
@inject SessionLockService SessionLock
@inject ApiClient Api
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<MudThemeProvider Theme="ThemeService.CurrentTheme" IsDarkMode="ThemeService.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (AuthState.IsAuthenticated)
{
    <MudLayout Class="app-shell">
        <MudAppBar Elevation="0" Class="app-bar-glass">
            <img src="logo.jpg" alt="Logo" style="height: 36px; width: 36px; border-radius: 50%; object-fit: cover; margin-right: 12px; border: 2px solid rgba(255,255,255,0.2);" />
            <MudText Typo="Typo.h6">DentalLocal</MudText>
            <MudSpacer />
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mr-4">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Inherit" Style="opacity:0.7" />
                <MudText Typo="Typo.body1" Class="font-weight-bold" Style="font-variant-numeric: tabular-nums;">@_now.ToString("HH:mm:ss")</MudText>
                <MudText Typo="Typo.caption" Style="opacity:0.7">@_now.ToString("dd.MM.yyyy")</MudText>
            </MudStack>
            <MudTooltip Text="@(ThemeService.Accent == AppAccent.Blue ? "Акцент: синий" : "Акцент: бирюзовый")">
                <MudIconButton Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" OnClick="ToggleAccent" />
            </MudTooltip>
            <MudTooltip Text="@(ThemeService.IsDark ? "Светлая тема" : "Тёмная тема")">
                <MudIconButton Icon="@(ThemeService.IsDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleMode" />
            </MudTooltip>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" title="Выход" />
        </MudAppBar>
        <MudDrawer Open="true" Elevation="0" Variant="DrawerVariant.Persistent" Class="app-drawer-glass">
            <NavMenu />
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
                <div class="page-fade-in" @key="Navigation.Uri">
                    @Body
                </div>
            </MudContainer>
        </MudMainContent>
    </MudLayout>

    @if (SessionLock.IsLocked)
    {
        <div class="lock-screen-overlay">
            <MudPaper Class="pa-8 lock-screen-card" Elevation="0">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-1">Экран заблокирован</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6" Color="Color.Secondary">
                    Введите код доступа, чтобы продолжить
                </MudText>

                @if (_unlockError is not null)
                {
                    <MudText Color="Color.Error" Align="Align.Center" Class="mb-2">@_unlockError</MudText>
                }

                <PinKeypad @bind-Code="_unlockCode" Disabled="_isUnlocking" />

                <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4"
                           OnClick="UnlockAsync" Disabled="@(string.IsNullOrEmpty(_unlockCode) || _isUnlocking)">
                    Разблокировать
                </MudButton>
            </MudPaper>
        </div>
    }
}
else
{
    <div class="page-fade-in" @key="Navigation.Uri">
        @Body
    </div>
}

@code {
    private DateTime _now = DateTime.Now;
    private System.Threading.Timer? _clockTimer;
    private string _unlockCode = string.Empty;
    private string? _unlockError;
    private bool _isUnlocking;
    private DotNetObjectReference<MainLayout>? _idleRef;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.Changed += OnThemeChanged;
        AuthState.Changed += OnThemeChanged;
        SessionLock.Changed += OnThemeChanged;
        await ThemeService.InitializeAsync();

        _clockTimer = new System.Threading.Timer(_ =>
        {
            _now = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        if (AuthState.IsAuthenticated)
            await StartIdleTrackingAsync();
    }

    private async Task StartIdleTrackingAsync()
    {
        try
        {
            var settings = await Api.GetSettingsAsync();
            var timeoutMs = Math.Max(1, settings.AutoLockMinutes) * 60_000;

            _idleRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("dentalIdle.start", _idleRef, timeoutMs);
        }
        catch (ApiException)
        {
            // Настройки ещё недоступны (например, только что вошли) — автоблокировка включится при следующей навигации.
        }
    }

    [JSInvokable]
    public void OnIdleTimeout() => SessionLock.Lock();

    private async Task UnlockAsync()
    {
        _isUnlocking = true;
        _unlockError = null;

        try
        {
            var response = await Api.LoginAsync(_unlockCode);
            AuthState.SetSession(response.Token, response.ExpiresAt);
            SessionLock.Unlock();
            _unlockCode = string.Empty;
            await JsRuntime.InvokeVoidAsync("dentalIdle.reset");
        }
        catch (ApiException ex)
        {
            _unlockError = ex.Message;
            _unlockCode = string.Empty;
        }
        finally
        {
            _isUnlocking = false;
        }
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private Task ToggleMode() => ThemeService.ToggleModeAsync();

    private Task ToggleAccent() => ThemeService.SetAccentAsync(
        ThemeService.Accent == AppAccent.Blue ? AppAccent.Teal : AppAccent.Blue);

    private void Logout()
    {
        AuthState.Clear();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.Changed -= OnThemeChanged;
        AuthState.Changed -= OnThemeChanged;
        SessionLock.Changed -= OnThemeChanged;
        _clockTimer?.Dispose();

        if (_idleRef is not null)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("dentalIdle.stop");
            }
            catch (JSDisconnectedException)
            {
                // Circuit уже закрыт — интероп недоступен, ничего страшного.
            }

            _idleRef.Dispose();
        }
    }
}
