@inherits LayoutComponentBase
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject ThemeService ThemeService
@inject SessionLockService SessionLock
@inject ApiClient Api
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<MudThemeProvider Theme="ThemeService.CurrentTheme" IsDarkMode="ThemeService.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (AuthState.IsAuthenticated)
{
    <MudLayout Class="app-shell">
        <MudAppBar Elevation="0" Class="app-bar-glass">
            <MudIconButton Icon="@LucideIcons.Menu" Color="Color.Inherit" Class="d-md-none mr-1"
                           OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Открыть меню" />
            <img src="logo.jpg" alt="Logo" class="app-logo" />
            <MudText Typo="Typo.h6" Class="d-none d-sm-flex">DentalLocal</MudText>
            <MudSpacer />
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mr-4 d-none d-sm-flex">
                <MudIcon Icon="@LucideIcons.Clock" Size="Size.Small" Color="Color.Inherit" Style="opacity:0.6" aria-hidden="true" />
                <MudText Typo="Typo.body1" Class="font-weight-bold" Style="font-variant-numeric: tabular-nums;">@_now.ToString("HH:mm:ss")</MudText>
                <MudText Typo="Typo.caption" Style="opacity:0.6">@_now.ToString("dd.MM.yyyy")</MudText>
            </MudStack>
            <MudMenu Icon="@LucideIcons.Globe" Color="Color.Inherit" AriaLabel="Выбор языка интерфейса">
                <MudMenuItem OnClick="@(() => SetLanguageAsync("ru"))">Русский</MudMenuItem>
                <MudMenuItem OnClick="@(() => SetLanguageAsync("tj"))">Тоҷикӣ</MudMenuItem>
                <MudMenuItem OnClick="@(() => SetLanguageAsync("en"))">English</MudMenuItem>
            </MudMenu>
            <MudTooltip Text="@(ThemeService.Accent == AppAccent.Blue ? "Акцент: синий" : "Акцент: бирюзовый")">
                <MudIconButton Icon="@LucideIcons.Palette" Color="Color.Inherit" OnClick="ToggleAccent"
                               aria-label="@(ThemeService.Accent == AppAccent.Blue ? "Сменить акцент на бирюзовый" : "Сменить акцент на синий")" />
            </MudTooltip>
            <MudTooltip Text="@(ThemeService.IsDark ? "Светлая тема" : "Тёмная тема")">
                <MudIconButton Icon="@(ThemeService.IsDark ? LucideIcons.Sun : LucideIcons.Moon)" Color="Color.Inherit" OnClick="ToggleMode"
                               aria-label="@(ThemeService.IsDark ? "Переключить на светлую тему" : "Переключить на тёмную тему")" />
            </MudTooltip>
            <MudTooltip Text="Выход">
                <MudIconButton Icon="@LucideIcons.Logout" Color="Color.Inherit" OnClick="Logout" aria-label="Выйти из системы" />
            </MudTooltip>
        </MudAppBar>
        <!-- На md+ (≥960px) остаётся постоянной боковой панелью, на телефонах/планшетах уже (<960px)
             становится выезжающей overlay-панелью, закрытой по умолчанию и переключаемой гамбургером
             выше — см. запрос на адаптивную вёрстку под телефон. -->
        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Class="app-drawer-glass">
            <NavMenu />
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-2 pa-sm-4">
                <div class="page-fade-in" @key="Navigation.Uri">
                    @Body
                </div>
            </MudContainer>
        </MudMainContent>
    </MudLayout>

    @if (SessionLock.IsLocked)
    {
        <div class="lock-screen-overlay">
            <MudPaper Class="pa-8 lock-screen-card" Elevation="0">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-1">Экран заблокирован</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6" Color="Color.Secondary">
                    Введите код доступа, чтобы продолжить
                </MudText>

                @if (_unlockError is not null)
                {
                    <MudText Color="Color.Error" Align="Align.Center" Class="mb-2">@_unlockError</MudText>
                }

                <PinKeypad @bind-Code="_unlockCode" Disabled="_isUnlocking" />

                <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4"
                           OnClick="UnlockAsync" Disabled="@(string.IsNullOrEmpty(_unlockCode) || _isUnlocking)">
                    Разблокировать
                </MudButton>
            </MudPaper>
        </div>
    }
}
else
{
    <div class="page-fade-in" @key="Navigation.Uri">
        @Body
    </div>
}

@code {
    private DateTime _now = DateTime.Now;
    private bool _drawerOpen = true;
    private readonly CancellationTokenSource _clockCts = new();
    private string _unlockCode = string.Empty;
    private string? _unlockError;
    private bool _isUnlocking;
    private DotNetObjectReference<MainLayout>? _idleRef;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.Changed += OnThemeChanged;
        AuthState.Changed += OnThemeChanged;
        SessionLock.Changed += OnThemeChanged;
        await ThemeService.InitializeAsync();

        _ = RunClockAsync(_clockCts.Token);

        if (AuthState.IsAuthenticated)
            await StartIdleTrackingAsync();
    }

    private async Task RunClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _now = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Компонент уничтожен — цикл часов останавливается штатно.
        }
    }

    private async Task StartIdleTrackingAsync()
    {
        try
        {
            var settings = await Api.GetSettingsAsync();
            var timeoutMs = Math.Max(1, settings.AutoLockMinutes) * 60_000;

            _idleRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("dentalIdle.start", _idleRef, timeoutMs);
        }
        catch (ApiException)
        {
            // Настройки ещё недоступны (например, только что вошли) — автоблокировка включится при следующей навигации.
        }
    }

    [JSInvokable]
    public void OnIdleTimeout() => SessionLock.Lock();

    private async Task UnlockAsync()
    {
        _isUnlocking = true;
        _unlockError = null;

        try
        {
            var response = await Api.LoginAsync(_unlockCode);
            AuthState.SetSession(response.Token, response.ExpiresAt);
            SessionLock.Unlock();
            _unlockCode = string.Empty;
            await JsRuntime.InvokeVoidAsync("dentalIdle.reset");
        }
        catch (ApiException ex)
        {
            _unlockError = ex.Message;
            _unlockCode = string.Empty;
        }
        finally
        {
            _isUnlocking = false;
        }
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task SetLanguageAsync(string languageCode)
    {
        await CultureService.SetStoredCultureAsync(JsRuntime, languageCode);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private Task ToggleMode() => ThemeService.ToggleModeAsync();

    private Task ToggleAccent() => ThemeService.SetAccentAsync(
        ThemeService.Accent == AppAccent.Blue ? AppAccent.Teal : AppAccent.Blue);

    private void Logout()
    {
        AuthState.Clear();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.Changed -= OnThemeChanged;
        AuthState.Changed -= OnThemeChanged;
        SessionLock.Changed -= OnThemeChanged;
        _clockCts.Cancel();
        _clockCts.Dispose();

        if (_idleRef is not null)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("dentalIdle.stop");
            }
            catch (JSDisconnectedException)
            {
                // Circuit уже закрыт — интероп недоступен, ничего страшного.
            }

            _idleRef.Dispose();
        }
    }
}
