@inherits LayoutComponentBase
@inject AuthState AuthState
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <img src="logo.jpg" alt="Logo" style="height: 40px; width: 40px; border-radius: 50%; object-fit: cover; margin-right: 12px; border: 2px solid rgba(255,255,255,0.2);" />
        <MudText Typo="Typo.h6">DentalLocal</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" title="Выход" />
    </MudAppBar>
    <MudDrawer Open="true" Elevation="0" Variant="DrawerVariant.Persistent">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private void Logout()
    {
        AuthState.Clear();
        Navigation.NavigateTo("/login", forceLoad: false);
    }
}
